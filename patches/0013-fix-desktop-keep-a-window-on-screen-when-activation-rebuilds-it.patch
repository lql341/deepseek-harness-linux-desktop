From cab868d314b7906eef8c15c55a8e5558032c7583 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 3 Oct 2026 09:39:32 +0800
Subject: [PATCH] fix(desktop): keep a window on screen when activation
 rebuilds it

Closing the last window now leaves the application running on Linux (the macOS behaviour this
port adds), and the first later launch rebuilds the welcome window. A second close, however,
leaves the process and its Host serving with nothing on screen: the rebuild path creates the main
window hidden and only openInitialWindow() decides what becomes visible, so when the backend is
not ready nothing is ever shown - the window tree holds nothing but the 10x10 tray helper, while
the Host endpoint still answers.

An activation asked for a window, so show the rebuilt one when the flow above left it hidden.
---
 apps/desktop/src/main.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 3b64696..e87dfa8 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -1239,7 +1239,12 @@ async function main(): Promise<void> {
     const window = welcomeWindow ?? mainWindow
     if (window === undefined || window.isDestroyed()) {
       try { createMainWindow() } catch (error) { reportFatal(error, 'main'); return }
-      void (backend.state.phase === 'ready' ? openInitialWindow() : navigateMain(applicationUrl)).catch((error: unknown) => { reportFatal(error, 'main') })
+      const created = mainWindow
+      void (backend.state.phase === 'ready' ? openInitialWindow() : navigateMain(applicationUrl)).then(() => {
+        // An activation asked for a window, so never leave a hidden one behind: once the welcome
+        // window has been closed the Host stays up but nothing else puts it back on screen.
+        if (!quitting && created !== undefined && !created.isDestroyed() && !created.isVisible()) created.show()
+      }).catch((error: unknown) => { reportFatal(error, 'main') })
       return
     }
     // Startup and sign-out select the visible window before activation may reveal the workspace.
