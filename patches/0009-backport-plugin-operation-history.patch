@@ -0,0 +1,120 @@
+/** Bounded, cancellable reads of Desktop-owned plugin operation history. */
+import { open } from 'node:fs/promises'
+import { join } from 'node:path'
+import { setImmediate } from 'node:timers/promises'
+import { parsePluginOperationRecord, type PluginOperationRecord } from '@deepseek-ai/dsh-plugin-manager/diagnostic'
+
+/** Resource budgets for auxiliary history collection, independent of basic crash report writing. */
+export interface OperationHistoryReadLimits {
+  readonly bytes: number
+  readonly recordBytes: number
+  readonly records: number
+}
+
+/** Collection facts; incomplete history must not be interpreted as absence of plugin changes. */
+export interface OperationHistoryReadResult {
+  readonly records: readonly PluginOperationRecord[]
+  readonly bytesRead: number
+  /** Distinct files from which at least one byte was read. */
+  readonly filesRead: number
+  readonly truncated: boolean
+  readonly invalidRecords: number
+  readonly unavailableFiles: number
+  readonly cancelled: boolean
+}
+
+/**
+ * Read only the bounded tails of the two owned history files, newest segment first.
+ * Cancellation is observed between bounded records after yielding to Worker messages and stops subsequent I/O and parsing.
+ * An already-issued OS read must settle before its handle closes.
+ * @param directory - Desktop's operation history directory; unrelated files are never enumerated.
+ * @param limits - Positive byte, record-size and record-count budgets.
+ * @param signal - Caller-owned collection deadline or shutdown cancellation.
+ * @returns Partial records and explicit omissions; filesystem failures never reject the collection.
+ */
+export async function readOperationHistory(
+  directory: string,
+  limits: OperationHistoryReadLimits,
+  signal: AbortSignal,
+): Promise<OperationHistoryReadResult> {
+  if (![limits.bytes, limits.recordBytes, limits.records].every(value => Number.isSafeInteger(value) && value > 0)) {
+    throw new RangeError('Operation history budgets must be positive safe integers')
+  }
+  await setImmediate()
+  const cancelled = (): boolean => signal.aborted
+  const records: PluginOperationRecord[] = []
+  let bytesRead = 0
+  const seenFiles = new Set<string>()
+  let truncated = false
+  let invalidRecords = 0
+  let unavailableFiles = 0
+  for (const name of ['operations.jsonl', 'operations.previous.jsonl']) {
+    if (cancelled()) break
+    try {
+      await using handle = await open(join(directory, name), 'r')
+      if (cancelled()) break
+      const fileStat = await handle.stat()
+      if (cancelled()) break
+      if (!fileStat.isFile()) {
+        unavailableFiles++
+        continue
+      }
+      const identity = `${String(fileStat.dev)}:${String(fileStat.ino)}`
+      if (seenFiles.has(identity)) {
+        truncated = true
+        continue
+      }
+      if (fileStat.size > 0 && (bytesRead >= limits.bytes || records.length >= limits.records)) {
+        truncated = true
+        break
+      }
+
+      const readLength = Math.min(fileStat.size, limits.bytes - bytesRead)
+      const readStart = fileStat.size - readLength
+      const buffer = Buffer.alloc(readLength)
+      let readOffset = 0
+      while (readOffset < readLength && !cancelled()) {
+        const read = await handle.read(buffer, readOffset, Math.min(16 * 1024, readLength - readOffset), readStart + readOffset)
+        bytesRead += read.bytesRead
+        if (read.bytesRead === 0) break
+        readOffset += read.bytesRead
+      }
+      if (readOffset > 0) seenFiles.add(identity)
+      if (cancelled()) break
+      truncated ||= readStart > 0 || readOffset < readLength
+
+      // An unterminated last record can still be in flight; never parse it as a committed record.
+      if (readOffset === 0) continue
+      let lineEnd = buffer.lastIndexOf(10, readOffset - 1)
+      if (lineEnd !== readOffset - 1) truncated = true
+      while (lineEnd >= 0 && records.length < limits.records && !cancelled()) {
+        await setImmediate()
+        if (cancelled()) break
+        const previousLineEnd = lineEnd === 0 ? -1 : buffer.lastIndexOf(10, lineEnd - 1)
+        if (previousLineEnd < 0 && readStart > 0) {
+          truncated = true
+          break
+        }
+        const recordBytes = lineEnd - previousLineEnd - 1
+        if (recordBytes > limits.recordBytes) {
+          invalidRecords++
+        } else if (recordBytes > 0) {
+          try {
+            const value: unknown = JSON.parse(buffer.subarray(previousLineEnd + 1, lineEnd).toString('utf8'))
+            const record = parsePluginOperationRecord(value)
+            if (record === undefined) invalidRecords++
+            else records.push(record)
+          } catch (_error) {
+            // A corrupt record does not invalidate independently delimited older records.
+            invalidRecords++
+          }
+        }
+        lineEnd = previousLineEnd
+      }
+      if (lineEnd >= 0) truncated = true
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') unavailableFiles++
+    }
+  }
+  return { records, bytesRead, filesRead: seenFiles.size, truncated, invalidRecords, unavailableFiles, cancelled: cancelled() }
+}
diff --git a/apps/desktop/src/operation-journal.ts b/apps/desktop/src/operation-journal.ts
new file mode 100644
index 0000000..b72cc6b
--- /dev/null
+++ b/apps/desktop/src/operation-journal.ts
@@ -0,0 +1,208 @@
+/** Single-shell, bounded persistence for already-projected operation diagnostics. */
+import { mkdir, open, rename, stat, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+
+/** Budgets include serialized JSON and its line delimiter. */
+export interface OperationJournalLimits {
+  readonly segmentBytes: number
+  readonly recordBytes: number
+  readonly queuedBytes: number
+}
+
+/** In-memory omissions for the current shell lifetime; missing records never imply no operations occurred. */
+export interface OperationJournalStatus {
+  readonly dropped: number
+  readonly failed: number
+  readonly queuedBytes: number
+  readonly disabled: boolean
+  /** Damaged or oversized segments repaired; their lost record count is unknown. */
+  readonly repairedSegments: number
+}
+
+/** Owns two known files and one serial writer; the owning shell must exclude other writers. */
+export class OperationJournal {
+  private readonly queue: string[] = []
+  private queuedBytes = 0
+  private dropped = 0
+  private failed = 0
+  private repairedSegments = 0
+  private disabled = false
+  private closed = false
+  private writing: Promise<void> | undefined
+  private initialized = false
+  private readonly abort = new AbortController()
+
+  /**
+   * @param directory - Directory reserved for the shell's operation journal.
+   * @param limits - Positive byte budgets, with recordBytes no greater than either other budget.
+   */
+  constructor(
+    private readonly directory: string,
+    private readonly limits: OperationJournalLimits,
+  ) {
+    if (![limits.segmentBytes, limits.recordBytes, limits.queuedBytes].every(value => Number.isSafeInteger(value) && value > 0)
+      || limits.recordBytes > limits.segmentBytes || limits.recordBytes > limits.queuedBytes) {
+      throw new RangeError('Invalid operation journal budgets')
+    }
+  }
+
+  /**
+   * Queue one prevalidated, whitelisted JSON record without awaiting disk I/O.
+   * @param record - An already serialized JSON object without literal line delimiters.
+   * @returns Whether the record was accepted; disk failures are reported separately by status().
+   */
+  enqueue(record: string): boolean {
+    const line = record + '\n'
+    const bytes = Buffer.byteLength(line)
+    if (this.closed || this.disabled || bytes > this.limits.recordBytes
+      || bytes + this.queuedBytes > this.limits.queuedBytes || /[\r\n]/u.test(record)) {
+      this.dropped++
+      return false
+    }
+    this.queue.push(line)
+    this.queuedBytes += bytes
+    this.startWriter()
+    return true
+  }
+
+  /** @returns Current queue occupancy and omission counters. */
+  status(): OperationJournalStatus {
+    return {
+      dropped: this.dropped,
+      failed: this.failed,
+      queuedBytes: this.queuedBytes,
+      disabled: this.disabled,
+      repairedSegments: this.repairedSegments,
+    }
+  }
+
+  /** Stop accepting records and await completion of the owned writer. */
+  async close(): Promise<void> {
+    this.closed = true
+    while (this.writing !== undefined) await this.writing
+  }
+
+  /**
+   * Wait for queued records during shutdown or installer handoff without holding the application indefinitely.
+   * @param timeoutMs - Waiting budget before disabling the writer and cancelling subsequent I/O.
+   * @returns True after the queue settles successfully; false immediately when disabled, or on failure or deadline.
+   * False does not confirm that an issued OS request has settled.
+   */
+  async drain(timeoutMs: number): Promise<boolean> {
+    if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1) throw new RangeError('Invalid journal drain deadline')
+    if (this.disabled) return false
+    let timer: ReturnType<typeof setTimeout> | undefined
+    try {
+      return await Promise.race([
+        (async () => {
+          while (this.writing !== undefined) await this.writing
+          return !this.disabled
+        })(),
+        new Promise<false>((resolve) => {
+          timer = setTimeout(() => {
+            this.disabled = true
+            this.abort.abort()
+            resolve(false)
+          }, timeoutMs)
+        }),
+      ])
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+
+  private startWriter(): void {
+    this.writing ??= this.writeQueue().finally(() => {
+      this.writing = undefined
+      if (this.queue.length > 0) this.startWriter()
+    })
+  }
+
+  private async writeQueue(): Promise<void> {
+    try {
+      await mkdir(this.directory, { recursive: true, mode: 0o700 })
+      this.abort.signal.throwIfAborted()
+      const current = join(this.directory, 'operations.jsonl')
+      const previous = join(this.directory, 'operations.previous.jsonl')
+      if (!this.initialized) {
+        await this.prepareSegments(current, previous)
+        this.initialized = true
+      }
+      for (let line = this.queue[0]; line !== undefined; line = this.queue[0]) {
+        this.abort.signal.throwIfAborted()
+        const bytes = Buffer.byteLength(line)
+        let size = 0
+        try {
+          size = (await stat(current)).size
+        }
+        catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+        }
+        this.abort.signal.throwIfAborted()
+        if (size > this.limits.segmentBytes) {
+          // An oversized pre-existing segment is not copied into the bounded retained history.
+          await writeFile(current, '', { mode: 0o600 })
+          this.repairedSegments++
+        } else if (size + bytes > this.limits.segmentBytes) {
+          await rename(current, previous)
+        }
+        this.abort.signal.throwIfAborted()
+        await writeFile(current, line, { flag: 'a', mode: 0o600, signal: this.abort.signal })
+        this.queue.shift()
+        this.queuedBytes -= bytes
+      }
+    } catch (_error) {
+      // A failed append may have written a partial line; disable this writer rather than concatenate another record.
+      this.disabled = true
+      this.failed += this.queue.length
+      this.queue.length = 0
+      this.queuedBytes = 0
+    }
+  }
+
+  private async prepareSegments(current: string, previous: string): Promise<void> {
+    try {
+      const size = (await stat(previous)).size
+      this.abort.signal.throwIfAborted()
+      if (size > this.limits.segmentBytes) {
+        await writeFile(previous, '', { mode: 0o600 })
+        this.repairedSegments++
+      }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+    }
+    this.abort.signal.throwIfAborted()
+    {
+      await using handle = await open(current, 'r+').catch((error: unknown) => {
+        if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+        this.abort.signal.throwIfAborted()
+        return open(current, 'wx+', 0o600)
+      })
+      this.abort.signal.throwIfAborted()
+      const size = (await handle.stat()).size
+      this.abort.signal.throwIfAborted()
+      if (size > this.limits.segmentBytes) {
+        await handle.truncate(0)
+        this.repairedSegments++
+      } else if (size > 0) {
+        const byte = Buffer.alloc(1)
+        const read = await handle.read(byte, 0, 1, size - 1)
+        if (read.bytesRead !== 1 || byte[0] !== 10) {
+          const buffer = Buffer.alloc(size)
+          let offset = 0
+          while (offset < size) {
+            this.abort.signal.throwIfAborted()
+            const chunk = await handle.read(buffer, offset, size - offset, offset)
+            if (chunk.bytesRead === 0) break
+            offset += chunk.bytesRead
+          }
+          this.abort.signal.throwIfAborted()
+          // Keep committed lines in both segments; only the unfinished append is discarded.
+          await handle.truncate(buffer.subarray(0, offset).lastIndexOf(10) + 1)
+          this.repairedSegments++
+        }
+      }
+    }
+    this.abort.signal.throwIfAborted()
+  }
+}
