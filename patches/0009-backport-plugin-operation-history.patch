new file mode 100644
index 0000000..3d29e97
--- /dev/null
+++ b/apps/desktop-host/src/operation-diagnostics.ts
@@ -0,0 +1,34 @@
+/** Bounded delivery of management facts to the shell which owns durable diagnostics. */
+import type { Context } from '@deepseek-ai/cordis'
+import { parsePluginOperationRecord, type PluginOperationRecord, type PluginOperationRunId } from '@deepseek-ai/dsh-plugin-manager/diagnostic'
+
+/**
+ * Observe manager operations after Host startup, with bounded concurrent IPC deliveries.
+ * @param ctx - Context owning the subscription and its pending deliveries.
+ * @param send - IPC transport promise which settles when delivery succeeds or fails.
+ * @param maxPending - Maximum number of outstanding deliveries; excess events are counted and omitted.
+ * @param runId - Host lifetime identity announced before profile startup.
+ */
+export function installOperationDiagnostics(
+  ctx: Context, send: (record: PluginOperationRecord) => Promise<void>, maxPending: number, runId: PluginOperationRunId,
+): void {
+  if (!Number.isSafeInteger(maxPending) || maxPending < 1) throw new RangeError('Invalid diagnostic delivery budget')
+  const pending = new Set<Promise<void>>()
+  let dropped = 0
+  let closed = false
+  ctx.on('plugin-manager/operation', (operation) => {
+    if (closed || pending.size >= maxPending) { dropped++; return }
+    const record = parsePluginOperationRecord({ runId, operation, transportDropped: dropped })
+    if (record === undefined) { dropped++; return }
+    const delivery = Promise.resolve().then(async () => {
+      try { await send(record) }
+      catch (_error) { dropped++ /* IPC failure does not change the management operation. */ }
+    })
+    pending.add(delivery)
+    void delivery.then(() => { pending.delete(delivery) })
+  })
+  ctx.effect(() => async () => {
+    closed = true
+    await Promise.allSettled(pending)
+  })
+}
diff --git a/apps/desktop-host/tests/operation-diagnostics.spec.ts b/apps/desktop-host/tests/operation-diagnostics.spec.ts
new file mode 100644
index 0000000..fbf8f03
--- /dev/null
+++ b/apps/desktop-host/tests/operation-diagnostics.spec.ts
@@ -0,0 +1,41 @@
+import { Context } from '@deepseek-ai/cordis'
+import type { PluginOperation } from '@deepseek-ai/dsh-plugin-manager/types'
+import type { PluginOperationRunId } from '@deepseek-ai/dsh-plugin-manager/diagnostic'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { installOperationDiagnostics } from '../src/operation-diagnostics.ts'
+
+const operation: PluginOperation = {
+  id: 'c254ab28-97c9-4382-95e6-2db9c66f98c9' as PluginOperation['id'],
+  time: '2026-10-19T00:00:00.000Z', reason: 'plugin', phase: 'started', target: 'managed', stage: 'enable',
+}
+const runId = 'c254ab28-97c9-4382-95e6-2db9c66f98c8' as PluginOperationRunId
+
+it('bounds outstanding deliveries and drains them on context disposal', async () => {
+  const ctx = new Context()
+  const entered = Promise.withResolvers<undefined>()
+  const release = Promise.withResolvers<undefined>()
+  onTestFinished(async () => { release.resolve(undefined); await ctx.fiber.dispose() })
+  const send = vi.fn(async () => { entered.resolve(undefined); await release.promise })
+  installOperationDiagnostics(ctx, send, 1, runId)
+  ctx.emit('plugin-manager/operation', operation)
+  await entered.promise
+  for (let i = 0; i < 1000; i++) ctx.emit('plugin-manager/operation', operation)
+  expect(send).toHaveBeenCalledTimes(1)
+  expect(send).toHaveBeenCalledWith(expect.objectContaining({ runId }))
+  let stopped = false
+  const stopping = ctx.fiber.dispose().then(() => { stopped = true })
+  await Promise.resolve(undefined)
+  expect(stopped).toBe(false)
+  release.resolve(undefined)
+  await stopping
+  ctx.emit('plugin-manager/operation', operation)
+  expect(send).toHaveBeenCalledTimes(1)
+})
+
+it('contains transport rejections during teardown', async () => {
+  const ctx = new Context()
+  onTestFinished(async () => { await ctx.fiber.dispose() })
+  installOperationDiagnostics(ctx, async () => { throw new Error('disconnected') }, 1, runId)
+  ctx.emit('plugin-manager/operation', operation)
+  await expect(ctx.fiber.dispose()).resolves.toBeUndefined()
+})
