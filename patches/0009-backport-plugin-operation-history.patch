diff --git a/apps/desktop/tests/operation-history.spec.ts b/apps/desktop/tests/operation-history.spec.ts
new file mode 100644
index 0000000..237287d
--- /dev/null
+++ b/apps/desktop/tests/operation-history.spec.ts
@@ -0,0 +1,172 @@
+import { mkdtemp, mkdir, open, rename, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { readOperationHistory } from '../src/operation-history.ts'
+
+vi.mock('node:fs/promises', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:fs/promises')>()
+  return { ...actual, open: vi.fn(actual.open) }
+})
+
+const limits = { bytes: 64 * 1024, recordBytes: 2048, records: 100 }
+function record(id: string | number) {
+  return { runId: 'c254ab28-97c9-4382-95e6-2db9c66f98c8', transportDropped: 0,
+    operation: { id: 'c254ab28-97c9-4382-95e6-2db9c66f98c9', time: '2026-10-19T00:00:00.000Z',
+      reason: 'plugin', phase: 'started', target: String(id), stage: 'enable' } }
+}
+function line(id: string | number) { return JSON.stringify(record(id)) + '\n' }
+
+async function fixture() {
+  const path = await mkdtemp(join(tmpdir(), 'desktop-operation-history-'))
+  onTestFinished(async () => { await rm(path, { recursive: true, force: true }) })
+  return path
+}
+
+it('collects recent complete records and reports malformed and incomplete entries', async () => {
+  const path = await fixture()
+  await writeFile(join(path, 'operations.jsonl'), line(1) + '{broken}\n' + line(2) + '{"incomplete":')
+  await writeFile(join(path, 'operations.previous.jsonl'), line(0))
+  const result = await readOperationHistory(path, limits, new AbortController().signal)
+  expect(result.records).toEqual([record(2), record(1), record(0)])
+  expect(result).toMatchObject({ invalidRecords: 1, truncated: true, cancelled: false, unavailableFiles: 0 })
+})
+
+it('reads no more than its byte budget from a two GiB file and ignores unrelated history', async () => {
+  const path = await fixture()
+  await using large = await open(join(path, 'operations.jsonl'), 'w')
+  const size = 2 * 1024 * 1024 * 1024
+  await large.truncate(size)
+  const tail = Buffer.from('\n' + line('last'))
+  await large.write(tail, 0, tail.length, size - tail.length)
+  await writeFile(join(path, 'pnpm.log'), 'unrelated output')
+  const result = await readOperationHistory(path, limits, new AbortController().signal)
+  expect(result.records).toEqual([record('last')])
+  expect(result.bytesRead).toBe(limits.bytes)
+  expect(result.truncated).toBe(true)
+})
+
+it('bounds parsed record size and output count independently', async () => {
+  const path = await fixture()
+  await writeFile(join(path, 'operations.jsonl'), line(1) + '{"large":"' + 'x'.repeat(4096) + '"}\n' + line(2))
+  const result = await readOperationHistory(path, { ...limits, records: 2 }, new AbortController().signal)
+  expect(result.records).toEqual([record(2), record(1)])
+  expect(result.invalidRecords).toBe(1)
+})
+
+it('returns immediately without I/O when already cancelled', async () => {
+  const result = await readOperationHistory('not-a-directory', limits, AbortSignal.abort())
+  expect(result).toMatchObject({ records: [], bytesRead: 0, cancelled: true, unavailableFiles: 0 })
+})
+
+it('reports unreadable segments without failing the whole collection', async () => {
+  const path = await fixture()
+  await mkdir(join(path, 'operations.jsonl'))
+  await writeFile(join(path, 'operations.previous.jsonl'), line(1))
+  const result = await readOperationHistory(path, limits, new AbortController().signal)
+  expect(result.records).toEqual([record(1)])
+  expect(result.unavailableFiles).toBe(1)
+})
+
+it('awaits an in-flight read before closing and schedules no further reads after cancellation', async () => {
+  const path = await fixture()
+  const filename = join(path, 'operations.jsonl')
+  await writeFile(filename, ' '.repeat(limits.bytes))
+  const handle = await open(filename, 'r')
+  onTestFinished(async () => { await handle.close() })
+  const started = Promise.withResolvers<undefined>()
+  const release = Promise.withResolvers<undefined>()
+  const opener = vi.mocked(open).mockClear().mockResolvedValueOnce(handle)
+  const reader = vi.spyOn(handle, 'read').mockImplementationOnce(async () => {
+    started.resolve(undefined)
+    await release.promise
+    return { bytesRead: 1, buffer: Buffer.alloc(1) }
+  })
+  const controller = new AbortController()
+  let settled = false
+  const collecting = readOperationHistory(path, limits, controller.signal)
+    .then((result) => { settled = true; return result })
+  try {
+    await started.promise
+    controller.abort()
+    await Promise.resolve(undefined)
+    expect(settled).toBe(false)
+    expect(handle.fd).not.toBe(-1)
+    release.resolve(undefined)
+    expect(await collecting).toMatchObject({ cancelled: true, bytesRead: 1, records: [] })
+    expect(handle.fd).toBe(-1)
+    expect(reader).toHaveBeenCalledTimes(1)
+    expect(opener).toHaveBeenCalledTimes(1)
+  } finally {
+    release.resolve(undefined)
+    await collecting
+    reader.mockRestore()
+    opener.mockClear()
+    await handle.close()
+  }
+})
+
+it('contains truncation between stat and read and still collects the previous segment', async () => {
+  const path = await fixture()
+  const filename = join(path, 'operations.jsonl')
+  await writeFile(filename, line(2))
+  await writeFile(join(path, 'operations.previous.jsonl'), line(1))
+  const handle = await open(filename, 'r+')
+  onTestFinished(async () => { await handle.close() })
+  const originalStat = await handle.stat()
+  const stat = vi.spyOn(handle, 'stat').mockImplementationOnce(async () => {
+    await handle.truncate(0)
+    return originalStat
+  })
+  const opener = vi.mocked(open).mockClear().mockResolvedValueOnce(handle)
+  try {
+    const result = await readOperationHistory(path, limits, new AbortController().signal)
+    expect(result).toMatchObject({ records: [record(1)], truncated: true, unavailableFiles: 0 })
+    expect(handle.fd).toBe(-1)
+  } finally {
+    stat.mockRestore()
+    opener.mockClear()
+    await handle.close()
+  }
+})
+
+it('rejects invalid resource budgets before opening a file', async () => {
+  for (const bytes of [0, -1, 0.5, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    await expect(readOperationHistory('not-a-directory', { ...limits, bytes }, new AbortController().signal))
+      .rejects.toThrow(RangeError)
+  }
+})
+
+it('does not collect the same open segment twice when it rotates during collection', async () => {
+  const path = await fixture()
+  const current = join(path, 'operations.jsonl')
+  await writeFile(current, line(1))
+  const handle = await open(current, 'r')
+  onTestFinished(async () => { await handle.close() })
+  const opener = vi.mocked(open).mockImplementationOnce(async () => {
+    await rename(current, join(path, 'operations.previous.jsonl'))
+    await writeFile(current, line(2))
+    return handle
+  })
+  try {
+    const result = await readOperationHistory(path, limits, new AbortController().signal)
+    expect(result.records).toEqual([record(1)])
+    expect(result).toMatchObject({ filesRead: 1, truncated: true })
+    expect(handle.fd).toBe(-1)
+  } finally {
+    opener.mockClear()
+    await handle.close()
+  }
+})
+
+it.each(['absent', 'empty', 'nonempty'])('reports omitted bytes at an exact budget: previous segment %s', async (previous) => {
+  const path = await fixture()
+  const current = line(1)
+  await writeFile(join(path, 'operations.jsonl'), current)
+  if (previous !== 'absent') await writeFile(join(path, 'operations.previous.jsonl'), previous === 'empty' ? '' : line(0))
+  const result = await readOperationHistory(path,
+    { ...limits, bytes: Buffer.byteLength(current), records: 1 }, new AbortController().signal)
+  expect(result.records).toEqual([record(1)])
+  expect(result.truncated).toBe(previous === 'nonempty')
+  expect(result.filesRead).toBe(1)
+})
diff --git a/apps/desktop/tests/operation-journal.spec.ts b/apps/desktop/tests/operation-journal.spec.ts
new file mode 100644
index 0000000..98e97d3
--- /dev/null
+++ b/apps/desktop/tests/operation-journal.spec.ts
@@ -0,0 +1,115 @@
+import { mkdir, mkdtemp, readFile, readdir, rm, stat, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { OperationJournal } from '../src/operation-journal.ts'
+
+vi.mock('node:fs/promises', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:fs/promises')>()
+  return { ...actual, mkdir: vi.fn(actual.mkdir) }
+})
+
+async function fixture() {
+  const directory = await mkdtemp(join(tmpdir(), 'desktop-operation-journal-'))
+  onTestFinished(async () => { await rm(directory, { recursive: true, force: true }) })
+  return directory
+}
+
+it('retains two bounded segments after dense operations across 50 plugins', async () => {
+  const directory = await fixture()
+  const journal = new OperationJournal(directory, { recordBytes: 128, segmentBytes: 1024, queuedBytes: 128 * 1000 })
+  onTestFinished(async () => { await journal.close() })
+  for (let i = 0; i < 1000; i++) expect(journal.enqueue(JSON.stringify({ plugin: i % 50, operation: i }))).toBe(true)
+  await journal.close()
+  expect((await readdir(directory)).sort()).toEqual(['operations.jsonl', 'operations.previous.jsonl'])
+  for (const name of await readdir(directory)) {
+    expect((await stat(join(directory, name))).size).toBeLessThanOrEqual(1024)
+    for (const line of (await readFile(join(directory, name), 'utf8')).trim().split('\n')) expect(() => { JSON.parse(line) }).not.toThrow()
+  }
+  expect(await readFile(join(directory, 'operations.jsonl'), 'utf8')).toContain('"operation":999')
+  expect(journal.status()).toEqual({ dropped: 0, failed: 0, queuedBytes: 0, disabled: false, repairedSegments: 0 })
+})
+
+it('bounds the queue and encoded record bytes including multibyte characters and newline', async () => {
+  const directory = await fixture()
+  const journal = new OperationJournal(directory, { recordBytes: 8, segmentBytes: 32, queuedBytes: 16 })
+  onTestFinished(async () => { await journal.close() })
+  expect(journal.enqueue('{"中":1}')).toBe(false)
+  expect(journal.enqueue('{"a":1}')).toBe(true)
+  expect(journal.enqueue('{"a":2}')).toBe(true)
+  expect(journal.enqueue('{"a":3}')).toBe(false)
+  expect(journal.status()).toMatchObject({ queuedBytes: 16, dropped: 2 })
+  await journal.close()
+  expect(await readFile(join(directory, 'operations.jsonl'), 'utf8')).toBe('{"a":1}\n{"a":2}\n')
+  expect(journal.enqueue('{}')).toBe(false)
+})
+
+it('disables persistence after a write failure without rejecting producers or close', async () => {
+  const directory = await fixture()
+  const blocked = join(directory, 'file')
+  await writeFile(blocked, 'untouched')
+  const journal = new OperationJournal(blocked, { recordBytes: 32, segmentBytes: 64, queuedBytes: 64 })
+  expect(journal.enqueue('{"operation":1}')).toBe(true)
+  await expect(journal.close()).resolves.toBeUndefined()
+  expect(journal.status()).toEqual({ dropped: 0, failed: 1, queuedBytes: 0, disabled: true, repairedSegments: 0 })
+  expect(await readFile(blocked, 'utf8')).toBe('untouched')
+})
+
+it.each(['', '{"old":1}\n'])('preserves both segments when repairing a partial append after %j', async (prefix) => {
+  const directory = await fixture()
+  const previous = '{"previous":0}\n'
+  await writeFile(join(directory, 'operations.previous.jsonl'), previous)
+  await writeFile(join(directory, 'operations.jsonl'), prefix + '{"partial":')
+  const journal = new OperationJournal(directory, { recordBytes: 32, segmentBytes: 64, queuedBytes: 64 })
+  expect(journal.enqueue('{"new":2}')).toBe(true)
+  await journal.close()
+  expect(await readFile(join(directory, 'operations.jsonl'), 'utf8')).toBe(prefix + '{"new":2}\n')
+  expect(await readFile(join(directory, 'operations.previous.jsonl'), 'utf8')).toBe(previous)
+  expect(journal.status()).toMatchObject({ repairedSegments: 1, disabled: false })
+})
+
+it('bounds both pre-existing oversized segments before writing new records', async () => {
+  const directory = await fixture()
+  for (const name of ['operations.jsonl', 'operations.previous.jsonl']) await writeFile(join(directory, name), 'x'.repeat(1000))
+  const journal = new OperationJournal(directory, { recordBytes: 32, segmentBytes: 64, queuedBytes: 64 })
+  journal.enqueue('{"new":2}')
+  await journal.close()
+  for (const name of await readdir(directory)) expect((await stat(join(directory, name))).size).toBeLessThanOrEqual(64)
+  expect(journal.status()).toMatchObject({ repairedSegments: 2, disabled: false })
+})
+
+it('stops scheduling writes after a drain deadline without claiming the in-flight request ended', async () => {
+  const directory = await fixture()
+  const entered = Promise.withResolvers<undefined>()
+  const release = Promise.withResolvers<undefined>()
+  vi.mocked(mkdir).mockImplementationOnce(async () => { entered.resolve(undefined); await release.promise; return undefined })
+  const journal = new OperationJournal(directory, { recordBytes: 32, segmentBytes: 64, queuedBytes: 64 })
+  onTestFinished(async () => { release.resolve(undefined); await journal.close(); vi.useRealTimers() })
+  journal.enqueue('{"operation":1}')
+  await entered.promise
+  vi.useFakeTimers()
+  const draining = journal.drain(500)
+  await vi.advanceTimersByTimeAsync(500)
+  expect(await draining).toBe(false)
+  expect(journal.status()).toMatchObject({ disabled: true, queuedBytes: 16 })
+  expect(journal.enqueue('{"operation":2}')).toBe(false)
+  let repeated: boolean | undefined
+  void journal.drain(500).then((result) => { repeated = result })
+  await vi.advanceTimersByTimeAsync(0)
+  expect(repeated).toBe(false)
+  release.resolve(undefined)
+  await journal.close()
+  expect(await readdir(directory)).toEqual([])
+  expect(journal.status()).toMatchObject({ failed: 1, queuedBytes: 0 })
+})
+
+it('can keep recording after successful installer preparation when the installer later fails', async () => {
+  const directory = await fixture()
+  const journal = new OperationJournal(directory, { recordBytes: 32, segmentBytes: 64, queuedBytes: 64 })
+  onTestFinished(async () => { await journal.close() })
+  journal.enqueue('{"operation":1}')
+  expect(await journal.drain(1000)).toBe(true)
+  expect(journal.enqueue('{"operation":2}')).toBe(true)
+  await journal.close()
+  expect(await readFile(join(directory, 'operations.jsonl'), 'utf8')).toBe('{"operation":1}\n{"operation":2}\n')
+})
