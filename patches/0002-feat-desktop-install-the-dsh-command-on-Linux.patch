index 0000000..36c9a6d
--- /dev/null
+++ b/apps/desktop/cli/dsh-linux
@@ -0,0 +1,63 @@
+#!/bin/sh
+# deepseek-harness linux launcher
+# Run the installed CLI without changing the invoking shell or working directory.
+set -e
+launcher=$0
+while [ -L "$launcher" ]; do
+  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
+  target=$(readlink "$launcher")
+  case "$target" in
+    /*) launcher=$target ;;
+    *) launcher=$directory/$target ;;
+  esac
+done
+# DSH_DESKTOP_RESOURCES names the resources directory explicitly, for extracted trees and diagnostics.
+if [ -n "${DSH_DESKTOP_RESOURCES:-}" ]; then
+  resources=$DSH_DESKTOP_RESOURCES
+else
+  resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
+fi
+root=$(CDPATH= cd -- "$resources/.." && pwd -P)
+case "$root" in
+  */.mount_*)
+    # An AppImage mount disappears with the application, so a command that points into it cannot survive.
+    echo "dsh: this launcher runs from a transient AppImage mount." >&2
+    echo "dsh: install the deb package, or extract the AppImage to a stable directory and set DSH_DESKTOP_RESOURCES." >&2
+    exit 1
+    ;;
+esac
+host=$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js
+if [ ! -f "$host" ]; then
+  echo "dsh: the DeepSeek Harness Desktop payload is missing under $resources" >&2
+  exit 1
+fi
+# Electron reuses the application binary as its Node runtime; the packaged name depends on the builder.
+executable=${DSH_DESKTOP_EXECUTABLE:-}
+if [ -z "$executable" ] || [ ! -x "$executable" ]; then
+  executable=
+  for name in deepseek-harness 'DeepSeek Harness' dsh-desktop; do
+    if [ -z "$executable" ] && [ -f "$root/$name" ] && [ -x "$root/$name" ]; then
+      executable=$root/$name
+    fi
+  done
+fi
+if [ -z "$executable" ]; then
+  # The Electron binary is the largest executable file beside resources; helpers and libraries are excluded.
+  size=0
+  for entry in "$root"/*; do
+    if [ ! -f "$entry" ] || [ ! -x "$entry" ]; then continue; fi
+    case "${entry##*/}" in
+      chrome-sandbox|chrome_crashpad_handler|*.so|*.so.*|*.pak|*.bin|*.dat) continue ;;
+    esac
+    candidate=$(wc -c < "$entry" 2>/dev/null | tr -d ' ' || echo 0)
+    if [ "${candidate:-0}" -gt "$size" ]; then
+      executable=$entry
+      size=$candidate
+    fi
+  done
+fi
+if [ -z "$executable" ] || [ ! -x "$executable" ]; then
+  echo "dsh: cannot locate the DeepSeek Harness executable under $root; set DSH_DESKTOP_EXECUTABLE." >&2
+  exit 1
+fi
+ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$host" "$@"
