-/** Shared geometry for the Windows main-window caption. */
+/** Shared geometry and platform policy for the window-controls overlay caption. */
 
-/** Windows application titlebar height in device-independent pixels. */
+/** Overlay caption height in device-independent pixels for Windows and Linux. */
 export const WINDOWS_TITLEBAR_HEIGHT = 40
+
+/**
+ * Whether this platform replaces the native caption with the window-controls overlay.
+ * Windows always uses the overlay; Linux uses the same mechanism unless its desktop
+ * environment keeps drawing a frame, selected by `DSH_DESKTOP_LINUX_NATIVE_FRAME=1`.
+ * The main process and the preloads read the same answer so the caption reservation,
+ * the fullscreen relay, and the native window options cannot disagree.
+ * @param platform - operating system reported by the main process or a preload.
+ * @param environment - matching process environment.
+ * @returns true when the window controls come from the overlay.
+ */
+export function usesTitleBarOverlay(platform: NodeJS.Platform, environment: NodeJS.ProcessEnv): boolean {
+  if (platform === 'win32') return true
+  return platform === 'linux' && environment.DSH_DESKTOP_LINUX_NATIVE_FRAME !== '1'
+}
