+  let harnessMenuOperation: Promise<void> | undefined
+  /**
+   * Manual Linux check from the native menu. It uses the same release feed as the Settings action,
+   * but a menu-triggered install first asks for confirmation, because the entry is labelled as a
+   * check rather than an install.
+   */
+  const runHarnessMenuUpdate = (): Promise<void> => {
+    harnessMenuOperation ??= (async () => {
+      const state = await harnessUpdates.check()
+      publishHarnessUpdate()
+      if (state.phase === 'current') {
+        await ordinaryMessageBox({ type: 'info', title: locale.messages.updateCheckTitle,
+          message: locale.messages.updateCurrent,
+          detail: formatDesktopMessage(locale.messages.updateCurrentDetail, { version: app.getVersion() }) })
+        return
+      }
+      if (state.phase === 'error') {
+        await ordinaryMessageBox({ type: 'error', title: locale.messages.updateCheckFailedTitle,
+          message: state.error === 'install' ? locale.messages.updateInstallFailed : locale.messages.updateCheckNetworkFailed })
+        return
+      }
+      if (state.phase !== 'available' || state.availableVersion === undefined) return
+      const parent = currentDialogWindow()
+      if (parent === undefined || parent.isDestroyed()) return
+      const result = await updateDialog.show(parent, {
+        type: 'info',
+        title: locale.messages.updateTitle,
+        message: formatDesktopMessage(locale.messages.updateAvailable, { version: state.availableVersion }),
+        detail: locale.messages.updateDetail,
+        buttons: [locale.messages.installAndRestart, locale.messages.later],
+        defaultId: 0,
+        cancelId: 1,
+      })
+      if (result.response !== 0 || quitting) return
+      await harnessUpdates.install()
+      publishHarnessUpdate()
+    })().catch((error: unknown) => {
+      console.error(error)
+    }).finally(() => { harnessMenuOperation = undefined })
+    return harnessMenuOperation
+  }
