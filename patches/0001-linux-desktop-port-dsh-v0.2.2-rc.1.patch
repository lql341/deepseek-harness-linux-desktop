diff --git a/apps/desktop/src/preload-scnet-status.ts b/apps/desktop/src/preload-scnet-status.ts
new file mode 100644
index 0000000000..8043c38403
--- /dev/null
+++ b/apps/desktop/src/preload-scnet-status.ts
@@ -0,0 +1,134 @@
+/** Main-window SCNet status surface; it only shows redacted local readiness facts. */
+
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC } from './ipc.ts'
+import type { ScnetDiagnostics } from './scnet-diagnostics.ts'
+
+interface ScnetStatusSnapshot {
+  readonly locale: 'en' | 'zh-CN'
+  readonly diagnostics: ScnetDiagnostics
+}
+
+interface ScnetStatusBridge {
+  read(): Promise<ScnetStatusSnapshot>
+  openDiagnostics(): Promise<void>
+  openSetup(): Promise<void>
+}
+
+const bridge: ScnetStatusBridge = {
+  read: () => ipcRenderer.invoke(DESKTOP_IPC.scnetStatus) as Promise<ScnetStatusSnapshot>,
+  openDiagnostics: () => ipcRenderer.invoke(DESKTOP_IPC.scnetStatusOpenDiagnostics) as Promise<void>,
+  openSetup: () => ipcRenderer.invoke(DESKTOP_IPC.scnetSetup) as Promise<void>,
+}
+
+const copy = {
+  en: {
+    title: 'SCNet',
+    action: 'Configure SCNet',
+    ready: 'Ready',
+    needsSetup: 'Authorization required',
+    unavailable: 'Local dependency unavailable',
+    disabled: 'Disabled',
+  },
+  'zh-CN': {
+    title: 'SCNet',
+    action: '配置 SCNet',
+    ready: '已就绪',
+    needsSetup: '需要授权',
+    unavailable: '本地依赖不可用',
+    disabled: '已禁用',
+  },
+} as const
+
+function install(): void {
+  if (document.querySelector('[data-dsh-scnet-status]') !== null) return
+  const host = document.createElement('div')
+  host.dataset.dshScnetStatus = ''
+  const shadow = host.attachShadow({ mode: 'open' })
+  const style = document.createElement('style')
+  style.textContent = `
+    :host { all: initial; }
+    .surface { align-items: center; backdrop-filter: blur(14px); background: color-mix(in srgb, Canvas 88%, transparent);
+      border: 1px solid color-mix(in srgb, CanvasText 14%, transparent); border-radius: 10px; box-shadow: 0 5px 22px rgb(0 0 0 / 12%);
+      color: CanvasText; display: flex; font: 12px/16px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+      gap: 9px; max-width: min(360px, calc(100vw - 28px)); padding: 9px 10px 9px 11px; }
+    .dot { background: #d28c24; border-radius: 50%; flex: 0 0 8px; height: 8px; width: 8px; }
+    .dot[data-state="ready"] { background: #1f9d68; }
+    .dot[data-state="unavailable"] { background: #c74b4b; }
+    .dot[data-state="disabled"] { background: #8d9298; }
+    .copy { display: grid; gap: 1px; min-width: 0; }
+    .title { font-weight: 650; }
+    .detail { color: color-mix(in srgb, CanvasText 66%, transparent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+    button { background: transparent; border: 0; color: inherit; cursor: pointer; font: inherit; padding: 3px 0 3px 5px; white-space: nowrap; }
+    button:hover { text-decoration: underline; }
+    button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 3px; }
+    .dismiss { color: color-mix(in srgb, CanvasText 52%, transparent); font-size: 16px; line-height: 16px; padding: 0 2px 2px 3px; }
+  `
+  const surface = document.createElement('div')
+  surface.className = 'surface'
+  const dot = document.createElement('span')
+  dot.className = 'dot'
+  dot.setAttribute('aria-hidden', 'true')
+  const content = document.createElement('span')
+  content.className = 'copy'
+  const title = document.createElement('span')
+  title.className = 'title'
+  const detail = document.createElement('span')
+  detail.className = 'detail'
+  content.append(title, detail)
+  const action = document.createElement('button')
+  action.type = 'button'
+  const dismiss = document.createElement('button')
+  dismiss.className = 'dismiss'
+  dismiss.type = 'button'
+  dismiss.textContent = '×'
+  dismiss.setAttribute('aria-label', 'Dismiss')
+  surface.append(dot, content, action, dismiss)
+  shadow.append(style, surface)
+  Object.assign(host.style, {
+    bottom: '14px',
+    position: 'fixed',
+    right: '14px',
+    zIndex: '2147483640',
+  })
+  document.body.append(host)
+  let latestDiagnostics: ScnetDiagnostics | undefined
+  async function refresh(): Promise<void> {
+    try {
+      const { locale, diagnostics } = await bridge.read()
+      latestDiagnostics = diagnostics
+      const m = locale === 'zh-CN' ? copy['zh-CN'] : copy.en
+      const state = diagnostics.overall
+      const status = state === 'ready' ? m.ready
+        : state === 'needs-setup' ? m.needsSetup
+          : state === 'disabled' ? m.disabled : m.unavailable
+      title.textContent = m.title
+      detail.textContent = `Bundle ${diagnostics.bundle.detail} · ${status}`
+      dot.dataset.state = state
+      action.textContent = m.action
+      action.setAttribute('aria-label', m.action)
+      dismiss.setAttribute('aria-label', locale === 'zh-CN' ? '关闭' : 'Dismiss')
+    } catch {
+      dispose()
+    }
+  }
+  function onFocus(): void { void refresh() }
+  function onPageHide(): void { dispose() }
+  function dispose(): void {
+    window.removeEventListener('focus', onFocus)
+    window.removeEventListener('pagehide', onPageHide)
+    host.remove()
+  }
+  dismiss.addEventListener('click', dispose)
+  action.addEventListener('click', () => {
+    void (latestDiagnostics?.overall === 'needs-setup' ? bridge.openSetup() : bridge.openDiagnostics()).catch(() => {})
+  })
+  window.addEventListener('focus', onFocus)
+  window.addEventListener('pagehide', onPageHide, { once: true })
+  void refresh()
+}
+
+export function installScnetStatusSurface(): void {
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true })
+  else install()
+}
diff --git a/apps/desktop/src/preload-update-status.ts b/apps/desktop/src/preload-update-status.ts
