+/** Independent Harness-core update discovery and installation for packaged Desktop builds. */
+
+import { valid, gt } from 'semver'
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+import { execFile } from 'node:child_process'
+import type { HarnessUpdatePresentation } from './ipc.ts'
+import { verifyReleaseManifest } from './release-trust.ts'
+
+export interface HarnessUpdateDependencies {
+  readonly currentVersion: string
+  readonly currentReleaseTag?: string
+  readonly packaged?: boolean
+  /** Target platform for the package installation; replaceable at the test boundary. */
+  readonly platform?: NodeJS.Platform
+  readonly environment?: NodeJS.ProcessEnv
+  readonly fetch?: typeof globalThis.fetch
+  readonly restart?: () => Promise<void> | void
+  /** Trust check for the downloaded manifest; replaceable at the test boundary. */
+  readonly verifyManifest?: (manifest: Uint8Array, signature: string) => boolean
+  /** Privileged installer for the verified package; replaceable at the test boundary. */
+  readonly installPackage?: (path: string) => Promise<void>
+}
+
+const DEFAULT_RELEASES_URL = 'https://api.github.com/repos/lql341/deepseek-harness-linux-desktop/releases'
+const RELEASE_TAG = /^v(.+)-linux\.(\d+)$/u
+const POLICY_ASSET = 'desktop-policy.json'
+const MANIFEST_ASSET = 'SHA256SUMS'
+const SIGNATURE_ASSET = 'SHA256SUMS.sig'
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function releaseVersion(tag: string): { version: string; build: number } | undefined {
+  const match = RELEASE_TAG.exec(tag)
+  const version = match?.[1]
+  const build = match?.[2]
+  if (version === undefined || build === undefined || valid(version) === null) return undefined
+  return { version, build: Number(build) }
+}
+
+function allowAlpha(environment: NodeJS.ProcessEnv): boolean {
+  return environment.DSH_HARNESS_UPDATE_ALLOW_ALPHA === '1'
+}
+
+type ReleaseAsset = { name: string; url: string }
+
+/** Lowest build a released client may keep running, published beside the package. */
+export interface DesktopReleasePolicy {
+  readonly minimumSupportedVersion: string
+  readonly minimumSupportedBuild?: number
+}
+
+type HarnessRelease = {
+  version: string
+  build: number
+  tag: string
+  url: string
+  notes?: string
+  assets: readonly ReleaseAsset[]
+  policy?: DesktopReleasePolicy
+}
+
+function parsePolicy(value: unknown): DesktopReleasePolicy | undefined {
+  if (!record(value) || typeof value.minimumSupportedVersion !== 'string'
+    || valid(value.minimumSupportedVersion) === null) return undefined
+  const build = value.minimumSupportedBuild
+  if (build !== undefined && (typeof build !== 'number' || !Number.isInteger(build) || build < 0)) return undefined
+  return {
+    minimumSupportedVersion: value.minimumSupportedVersion,
+    ...build === undefined ? {} : { minimumSupportedBuild: build },
+  }
+}
+
+function parseReleases(value: unknown, environment: NodeJS.ProcessEnv): HarnessRelease[] {
+  if (!Array.isArray(value)) throw new Error('harness update: invalid release response')
+  const releases: HarnessRelease[] = []
+  for (const entry of value) {
+    if (!record(entry)) continue
+    const tag = typeof entry.tag_name === 'string' ? entry.tag_name : undefined
+    const url = typeof entry.html_url === 'string' ? entry.html_url : undefined
+    if (tag === undefined || url === undefined || entry.draft === true) continue
+    let parsedUrl: URL
+    try { parsedUrl = new URL(url) } catch { continue }
+    if (parsedUrl.protocol !== 'https:' || parsedUrl.hostname !== 'github.com') continue
+    const parsed = releaseVersion(tag)
+    if (parsed === undefined || (!allowAlpha(environment) && parsed.version.includes('-alpha'))) continue
+    const assets = Array.isArray(entry.assets) ? entry.assets.flatMap((asset): ReleaseAsset[] => {
+      if (!record(asset) || typeof asset.name !== 'string' || typeof asset.browser_download_url !== 'string') return []
+      try {
+        const assetUrl = new URL(asset.browser_download_url)
+        return assetUrl.protocol === 'https:' && assetUrl.hostname === 'github.com'
+          ? [{ name: asset.name, url: asset.browser_download_url }]
+          : []
+      } catch { return [] }
+    }) : []
+    releases.push({
+      version: parsed.version,
+      build: parsed.build,
+      tag,
+      url,
+      assets,
+      ...(typeof entry.body === 'string' && entry.body !== '' ? { notes: entry.body } : {}),
+    })
+  }
+  return releases.sort((a, b) => gt(a.version, b.version) || (a.version === b.version && a.build > b.build) ? -1
+    : gt(b.version, a.version) || (a.version === b.version && a.build > b.build) ? 1 : 0)
+}
+
+/** A release whose bytes do not authenticate; installation must stop before touching the system. */
+class ReleaseTrustError extends Error {}
+
+export class HarnessUpdateCoordinator {
+  private current: HarnessUpdatePresentation
+  private pending: Promise<HarnessUpdatePresentation> | undefined
+  private disposed = false
+  private latest: HarnessRelease | undefined
+
+  constructor(private readonly dependencies: HarnessUpdateDependencies) {
+    this.current = { phase: 'idle', currentVersion: dependencies.currentVersion }
+  }
+
+  get state(): HarnessUpdatePresentation {
+    return this.current
+  }
+
+  async check(): Promise<HarnessUpdatePresentation> {
+    if (this.disposed) throw new Error('harness update: coordinator is disposed')
+    if (this.pending !== undefined) return this.pending
+    this.current = { phase: 'checking', currentVersion: this.dependencies.currentVersion }
+    this.pending = this.fetchLatest().then((state) => {
+      this.current = state
+      return state
+    }, () => {
+      this.current = { phase: 'error', currentVersion: this.dependencies.currentVersion, error: 'network' }
+      return this.current
+    }).finally(() => { this.pending = undefined })
+    return this.pending
+  }
+
+  async open(): Promise<string | undefined> {
+    if (this.current.phase === 'idle' || this.current.phase === 'error') await this.check()
+    return this.latest?.url ?? this.current.releaseUrl
+  }
+
+  /**
+   * Download, authenticate and install the checked release.
+   * @returns the resulting presentation; `error: 'untrusted'` means the bytes were rejected
+   *          before any privileged command ran.
+   */
+  async install(): Promise<HarnessUpdatePresentation> {
+    if (this.disposed) throw new Error('harness update: coordinator is disposed')
+    const state = this.current.phase === 'idle' || this.current.phase === 'error'
+      ? await this.check() : this.current
+    const installable = state.phase === 'available' || state.phase === 'required'
+    const release = this.latest
+    if (!installable || release === undefined) return state
+    this.current = { ...state, phase: 'installing' }
+    let trustFailure = false
+    try {
+      if ((this.dependencies.platform ?? process.platform) !== 'linux') throw new Error('harness update: Linux package installation is required')
+      const asset = (name: string): ReleaseAsset | undefined => release.assets.find(entry => entry.name === name)
+      const deb = release.assets.find(entry => entry.name.endsWith('.deb'))
+      const manifest = asset(MANIFEST_ASSET)
+      const signature = asset(SIGNATURE_ASSET)
+      // An unsigned release is not installable, even though it has a checksum: the manifest alone
+      // cannot prove who produced it, and this path runs a privileged package installation.
+      if (deb === undefined || manifest === undefined || signature === undefined) {
+        throw new ReleaseTrustError('harness update: release is not signed')
+      }
+      const fetcher = this.dependencies.fetch ?? globalThis.fetch
+      const directory = await mkdtemp(join(tmpdir(), 'deepseek-harness-update-'))
+      const debPath = join(directory, deb.name)
+      try {
+        const [debResponse, manifestResponse, signatureResponse] = await Promise.all([
+          fetcher(deb.url), fetcher(manifest.url), fetcher(signature.url),
+        ])
+        if (!debResponse.ok || !manifestResponse.ok || !signatureResponse.ok) {
+          throw new Error('harness update: asset download failed')
+        }
+        const debBytes = Buffer.from(await debResponse.arrayBuffer())
+        const manifestBytes = Buffer.from(await manifestResponse.arrayBuffer())
+        const trusted = this.dependencies.verifyManifest ?? verifyReleaseManifest
+        if (!trusted(manifestBytes, await signatureResponse.text())) {
+          throw new ReleaseTrustError('harness update: manifest signature is not trusted')
+        }
+        const expected = manifestBytes.toString('utf8').split(/\r?\n/u)
+          .find(line => line.endsWith(`  ${deb.name}`))?.split(/\s+/u)[0]
+        if (expected === undefined) throw new ReleaseTrustError('harness update: checksum is missing')
+        if (createHash('sha256').update(debBytes).digest('hex') !== expected) {
+          throw new ReleaseTrustError('harness update: checksum mismatch')
+        }
+        await writeFile(debPath, debBytes, { mode: 0o600 })
+        if (this.dependencies.installPackage !== undefined) await this.dependencies.installPackage(debPath)
+        else await promisify(execFile)('pkexec', ['apt-get', 'install', '-y', debPath], { timeout: 120_000 })
+      } finally {
+        await rm(directory, { recursive: true, force: true })
+      }
+      this.current = { phase: 'installed', currentVersion: release.version, availableVersion: release.version,
+        releaseTag: release.tag, releaseUrl: release.url }
+      await this.dependencies.restart?.()
+      return this.current
+    } catch (error) {
+      trustFailure = error instanceof ReleaseTrustError
+      this.current = { ...state, phase: 'error', error: trustFailure ? 'untrusted' : 'install' }
+      return this.current
+    }
+  }
+
+  dispose(): void {
+    this.disposed = true
+  }
+
+  private async fetchLatest(): Promise<HarnessUpdatePresentation> {
+    const environment = this.dependencies.environment ?? process.env
+    const fetcher = this.dependencies.fetch ?? globalThis.fetch
+    const endpoint = environment.DSH_HARNESS_UPDATE_RELEASES_URL?.trim() || DEFAULT_RELEASES_URL
+    const response = await fetcher(endpoint, {
+      headers: { accept: 'application/vnd.github+json', 'user-agent': 'deepseek-harness-linux-desktop' },
+      signal: AbortSignal.timeout(10_000),
+    })
+    if (!response.ok) throw new Error(`harness update: HTTP ${response.status}`)
+    const releases = parseReleases(await response.json(), environment)
+    const latest = releases[0]
+    if (latest === undefined) {
+      return { phase: 'current', currentVersion: this.dependencies.currentVersion }
+    }
+    const policyAsset = latest.assets.find(entry => entry.name === POLICY_ASSET)
+    if (policyAsset !== undefined) {
+      // The policy is part of the release, so read it from the same authenticated origin. A
+      // failure to read it must not hide an available update, but an unparsable policy is
+      // reported so a broken mandatory rule is visible instead of silently ignored.
+      const policyResponse = await fetcher(policyAsset.url, { signal: AbortSignal.timeout(10_000) })
+      if (policyResponse.ok) {
+        const policy = parsePolicy(await policyResponse.json())
+        if (policy === undefined) {
+          return { phase: 'error', currentVersion: this.dependencies.currentVersion, error: 'invalid' }
+        }
+        latest.policy = policy
+      }
+    }
+    this.latest = latest
+    const currentTag = this.dependencies.currentReleaseTag
+    const current = currentTag === undefined ? undefined : releaseVersion(currentTag)
+    const currentBuild = current?.build ?? 0
+    const floor = latest.policy
+    let requiredVersion: string | undefined
+    if (floor !== undefined && (
+      gt(floor.minimumSupportedVersion, this.dependencies.currentVersion)
+      || (floor.minimumSupportedVersion === this.dependencies.currentVersion
+        && (floor.minimumSupportedBuild ?? 0) > currentBuild))) {
+      requiredVersion = floor.minimumSupportedVersion
+    }
+    const required = requiredVersion !== undefined
+    const newer = gt(latest.version, this.dependencies.currentVersion)
+      || (latest.version === this.dependencies.currentVersion && (
+        current === undefined
+          ? false
+          : latest.build > current.build
+      ))
+    if (required || newer) {
+      return {
+        phase: required ? 'required' : 'available',
+        currentVersion: this.dependencies.currentVersion,
+        availableVersion: latest.version,
+        releaseTag: latest.tag,
+        releaseUrl: latest.url,
+        ...(requiredVersion === undefined ? {} : { requiredVersion }),
+        ...(latest.notes === undefined ? {} : { notesUrl: latest.url }),
+      }
+    }
+    return { phase: 'current', currentVersion: this.dependencies.currentVersion }
+  }
+}
+
+export function parseHarnessReleases(value: unknown, environment: NodeJS.ProcessEnv = {}): readonly {
+  version: string
+  tag: string
+  url: string
+}[] {
+  return parseReleases(value, environment).map(({ version, tag, url }) => ({ version, tag, url }))
+}
