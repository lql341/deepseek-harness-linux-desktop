index 0000000000..6c32badb1f
--- /dev/null
+++ b/apps/desktop/src/scnet-bundle.ts
@@ -0,0 +1,18 @@
+/** Fixed SCNet bundle identity carried by Desktop releases. */
+
+/** npm package name used by the Desktop profile and runtime package set. */
+export const SCNET_BUNDLE_PACKAGE = 'dsh-scnet'
+
+/** Exact published bundle version embedded in this Desktop release. */
+export const SCNET_BUNDLE_VERSION = '0.6.13'
+
+/** Package spec fetched only while assembling a Desktop release. */
+export const SCNET_BUNDLE_SPEC = `${SCNET_BUNDLE_PACKAGE}@${SCNET_BUNDLE_VERSION}`
+
+/** Profile-local marker that prevents upgrades from re-enabling an explicitly disabled bundle. */
+export const SCNET_DISABLED_MARKER = '.dsh-scnet.disabled'
+
+/** Add the SCNet bundle after the shared Web application layers. */
+export function desktopProfileBundles(base: readonly string[]): string[] {
+  return base.includes(SCNET_BUNDLE_PACKAGE) ? [...base] : [...base, SCNET_BUNDLE_PACKAGE]
+}
diff --git a/apps/desktop/src/scnet-diagnostics-window.ts b/apps/desktop/src/scnet-diagnostics-window.ts
new file mode 100644
index 0000000000..5f86e516ef
--- /dev/null
+++ b/apps/desktop/src/scnet-diagnostics-window.ts
@@ -0,0 +1,106 @@
+/** Native SCNet diagnostics window with a read-only, redacted status bridge. */
+
+import { fileURLToPath } from 'node:url'
+import { BrowserWindow, ipcMain, type BrowserWindowConstructorOptions, type IpcMainInvokeEvent } from 'electron'
+import type { DesktopLocale } from './locale.ts'
+import { DESKTOP_IPC } from './ipc.ts'
+import type { ScnetDiagnostics } from './scnet-diagnostics.ts'
+
+export interface ScnetDiagnosticsApi {
+  readonly locale: DesktopLocale
+  read(): Promise<ScnetDiagnostics>
+  close(): Promise<void>
+  setup(): Promise<void>
+}
+
+interface ReadOperations {
+  read(): Promise<ScnetDiagnostics>
+  setup?(): Promise<void>
+}
+
+let activeWindow: BrowserWindow | undefined
+let disposeHandlers: (() => void) | undefined
+
+/**
+ * Build the fixed-size diagnostics window options.
+ * @param locale - Shell locale used by the isolated renderer.
+ * @returns Sandboxed options for the local diagnostics document.
+ */
+export function scnetDiagnosticsWindowOptions(locale: DesktopLocale): BrowserWindowConstructorOptions {
+  return {
+    width: 720,
+    height: 620,
+    useContentSize: true,
+    center: true,
+    resizable: true,
+    minimizable: false,
+    maximizable: false,
+    show: false,
+    title: locale.id === 'zh-CN' ? 'SCNet 连接诊断' : 'SCNet diagnostics',
+    webPreferences: {
+      preload: fileURLToPath(new URL('./preload-scnet-diagnostics.cjs', import.meta.url)),
+      additionalArguments: [`--dsh-scnet-locale=${locale.id}`],
+      nodeIntegration: false,
+      contextIsolation: true,
+      sandbox: true,
+      webSecurity: true,
+    },
+  }
+}
+
+/**
+ * Show or focus the single diagnostics window.
+ * @param locale - Current shell locale.
+ * @param operations - Local status reader.
+ * @returns The visible diagnostics window.
+ */
+export async function openScnetDiagnosticsWindow(locale: DesktopLocale, operations: ReadOperations): Promise<BrowserWindow> {
+  if (activeWindow !== undefined && !activeWindow.isDestroyed()) {
+    activeWindow.show()
+    activeWindow.focus()
+    return activeWindow
+  }
+  const window = new BrowserWindow(scnetDiagnosticsWindowOptions(locale))
+  activeWindow = window
+  disposeHandlers?.()
+  let active = true
+  const dispose = (): void => {
+    if (!active) return
+    active = false
+    ipcMain.removeHandler(DESKTOP_IPC.scnetDiagnostics)
+    ipcMain.removeHandler(DESKTOP_IPC.scnetDiagnosticsClose)
+    ipcMain.removeHandler(DESKTOP_IPC.scnetDiagnosticsSetup)
+    disposeHandlers = undefined
+    if (activeWindow === window) activeWindow = undefined
+  }
+  disposeHandlers = dispose
+  const assertSender = (event: IpcMainInvokeEvent): void => {
+    if (!active || event.sender !== window.webContents || event.senderFrame !== window.webContents.mainFrame) {
+      throw new Error('desktop SCNet diagnostics: rejected action from an unowned frame')
+    }
+  }
+  ipcMain.handle(DESKTOP_IPC.scnetDiagnostics, (event) => {
+    assertSender(event)
+    return operations.read()
+  })
+  ipcMain.handle(DESKTOP_IPC.scnetDiagnosticsClose, (event) => {
+    assertSender(event)
+    if (!window.isDestroyed()) window.close()
+  })
+  ipcMain.handle(DESKTOP_IPC.scnetDiagnosticsSetup, (event) => {
+    assertSender(event)
+    return operations.setup?.()
+  })
+  window.once('closed', dispose)
+  window.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+  window.webContents.on('will-navigate', (event) => { event.preventDefault() })
+  try {
+    await window.loadURL('dsh-app://shell/scnet-diagnostics.html')
+  } catch (error) {
+    dispose()
+    if (!window.isDestroyed()) window.destroy()
+    throw error
+  }
+  if (!window.isDestroyed()) window.show()
+  return window
+}
diff --git a/apps/desktop/src/scnet-diagnostics.ts b/apps/desktop/src/scnet-diagnostics.ts
new file mode 100644
index 0000000000..ab7f5dcd43
--- /dev/null
+++ b/apps/desktop/src/scnet-diagnostics.ts
@@ -0,0 +1,177 @@
+/** Local, redacted SCNet readiness facts used by the Desktop diagnostics window. */
+
+import { execFile as spawnFile } from 'node:child_process'
+import { existsSync, readFileSync, statSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { delimiter, join } from 'node:path'
+import { promisify } from 'node:util'
+import { SCNET_BUNDLE_PACKAGE, SCNET_BUNDLE_VERSION } from './scnet-bundle.ts'
+import { createLinuxScnetSecretStore } from './scnet-secret-service.ts'
+
+const execFile = promisify(spawnFile)
+
+export type ScnetStatus = 'ready' | 'needs-setup' | 'unavailable' | 'disabled'
+
+export interface ScnetDiagnosticItem {
+  readonly state: 'ready' | 'needs-setup' | 'unavailable' | 'disabled'
+  readonly detail: string
+}
+
+export interface ScnetDiagnostics {
+  readonly overall: ScnetStatus
+  readonly bundle: ScnetDiagnosticItem
+  readonly python: ScnetDiagnosticItem
+  readonly credentials: ScnetDiagnosticItem
+  readonly backend: ScnetDiagnosticItem
+  readonly authentication: ScnetDiagnosticItem
+}
+
+interface ScnetProfile {
+  readonly active: boolean
+  readonly disabled: boolean
+}
+
+interface ScnetConfig {
+  readonly backend: string
+  readonly credentialsConfigured: boolean
+  readonly secureStore: string | undefined
+}
+
+interface PythonProbe {
+  readonly state: ScnetDiagnosticItem['state']
+  readonly executable?: string
+  readonly version?: string
+}
+
+export interface ScnetDiagnosticsDependencies {
+  readonly profilePath: string
+  readonly environment?: NodeJS.ProcessEnv
+  readonly bundleVersion?: string
+  readonly commandExists?: (command: string) => boolean
+  readonly probePython?: (candidates: readonly string[], environment: NodeJS.ProcessEnv) => Promise<PythonProbe>
+}
+
+function readProfile(profilePath: string): ScnetProfile {
+  const marker = join(profilePath, '.dsh-scnet.disabled')
+  if (existsSync(marker)) return { active: false, disabled: true }
+  try {
+    const manifest = JSON.parse(readFileSync(join(profilePath, 'package.json'), 'utf8')) as {
+      dsh?: { profile?: { bundles?: unknown } }
+    }
+    const bundles = manifest.dsh?.profile?.bundles
+    return {
+      active: Array.isArray(bundles) && bundles.includes(SCNET_BUNDLE_PACKAGE),
+      disabled: false,
+    }
+  } catch {
+    return { active: false, disabled: false }
+  }
+}
+
+function configRoot(environment: NodeJS.ProcessEnv): string {
+  const configured = environment.XDG_CONFIG_HOME?.trim()
+  return join(configured === undefined || configured === '' ? join(homedir(), '.config') : configured, 'scnet-hpc')
+}
+
+function stringValue(value: unknown): string | undefined {
+  return typeof value === 'string' ? value : undefined
+}
+
+function readConfig(environment: NodeJS.ProcessEnv, commandExists: (command: string) => boolean): ScnetConfig {
+  const root = configRoot(environment)
+  let data: { DEFAULT_BACKEND?: unknown; openapi?: Record<string, unknown>; backend?: unknown } = {}
+  try {
+    const rootConfig: unknown = JSON.parse(readFileSync(join(root, 'config.json'), 'utf8'))
+    if (rootConfig !== null && typeof rootConfig === 'object') data = rootConfig
+  } catch {
+    // Missing or malformed local configuration is represented as "needs setup".
+  }
+  const backend = (stringValue(environment.SCNET_HPC_BACKEND)
+    ?? stringValue(data.DEFAULT_BACKEND)
+    ?? stringValue(data.backend)
+    ?? 'openapi').trim().toLowerCase()
+  const hasEnvironmentCredentials = Boolean(
+    environment.SCNET_OPENAPI_TOKEN?.trim()
+    || (
+      environment.SCNET_OPENAPI_USER?.trim()
+      && environment.SCNET_OPENAPI_ACCESS_KEY?.trim()
+      && environment.SCNET_OPENAPI_SECRET_KEY?.trim()
+    ),
+  )
+  const secureStore = process.platform === 'darwin' && commandExists('security')
+    ? 'macOS Keychain'
+    : createLinuxScnetSecretStore({ environment, commandExists })?.provider
+  return {
+    backend,
+    credentialsConfigured: hasEnvironmentCredentials,
+    secureStore,
+  }
+}
+
+async function defaultProbePython(candidates: readonly string[], environment: NodeJS.ProcessEnv): Promise<PythonProbe> {
+  for (const executable of candidates) {
+    try {
+      const result = await execFile(executable, ['--version'], { env: environment, timeout: 3000, maxBuffer: 4096 })
+      const output = `${result.stdout}\n${result.stderr}`.trim()
+      const version = output.match(/\bPython\s+(3\.[0-9]+(?:\.[0-9]+)?)\b/u)?.[1]
+      if (version !== undefined) return { state: 'ready', executable, version }
+      return { state: 'unavailable' }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') continue
+      return { state: 'unavailable' }
+    }
+  }
+  return { state: 'unavailable' }
+}
+
+function pythonCandidates(environment: NodeJS.ProcessEnv): string[] {
+  const configured = environment.DSH_SCNET_PYTHON?.trim() || environment.SCNET_PYTHON?.trim()
+  return configured === undefined || configured === '' ? ['python3', 'python'] : [configured]
+}
+
+function item(state: ScnetDiagnosticItem['state'], detail: string): ScnetDiagnosticItem {
+  return { state, detail }
+}
+
+/**
+ * Read local SCNet readiness without contacting SCNet or returning credential values.
+ * @param dependencies - Desktop-owned paths, environment, and testable local probes.
+ * @returns Redacted status facts suitable for a renderer.
+ */
+export async function readScnetDiagnostics(dependencies: ScnetDiagnosticsDependencies): Promise<ScnetDiagnostics> {
+  const environment = dependencies.environment ?? process.env
+  const profile = readProfile(dependencies.profilePath)
+  const version = dependencies.bundleVersion ?? SCNET_BUNDLE_VERSION
+  const commandExists = dependencies.commandExists ?? ((command: string) => {
+    const path = environment.PATH ?? ''
+    return path.split(delimiter).some((directory) => {
+      try { return statSync(join(directory, command)).isFile() }
+      catch { return false }
+    })
+  })
+  const config = readConfig(environment, commandExists)
+  const python = await (dependencies.probePython ?? defaultProbePython)(pythonCandidates(environment), environment)
+  const bundle = profile.disabled
+    ? item('disabled', version)
+    : profile.active
+      ? item('ready', version)
+      : item('unavailable', version)
+  const pythonItem = python.state === 'ready'
+    ? item('ready', `${python.version ?? 'Python 3'}${python.executable === undefined ? '' : ` (${python.executable})`}`)
+    : item('unavailable', 'Python 3')
+  const credentials = config.credentialsConfigured
+    ? item('ready', 'configured')
+    : config.secureStore === undefined
+      ? item('needs-setup', 'not configured')
+      : item('needs-setup', config.secureStore)
+  const backend = config.backend === 'openapi' || config.backend === 'ssh'
+    ? item('ready', config.backend)
+    : item('unavailable', config.backend || 'unknown')
+  const authentication = config.credentialsConfigured
+    ? item('needs-setup', 'authorization required')
+    : item('needs-setup', 'not configured')
+  const overall = profile.disabled ? 'disabled'
+    : !profile.active || pythonItem.state === 'unavailable' ? 'unavailable'
+      : credentials.state === 'ready' ? 'ready' : 'needs-setup'
+  return { overall, bundle, python: pythonItem, credentials, backend, authentication }
+}
