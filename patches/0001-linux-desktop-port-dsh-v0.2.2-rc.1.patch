+import { afterEach, expect, it, vi } from 'vitest'
+import { resolveDesktopLocale } from '../src/locale.ts'
+import { DESKTOP_IPC } from '../src/ipc.ts'
+
+const fixture = await vi.hoisted(async () => {
+  const { EventEmitter } = await import('node:events')
+  const handlers = new Map<string, (...args: unknown[]) => unknown>()
+  const windows: FakeWindow[] = []
+  class FakeWindow extends EventEmitter {
+    destroyed = false
+    readonly webContents = Object.assign(new EventEmitter(), {
+      mainFrame: {},
+      setWindowOpenHandler: vi.fn(),
+    })
+    readonly loadURL = vi.fn(async () => {})
+    readonly show = vi.fn()
+    readonly focus = vi.fn()
+    constructor(readonly options: unknown) { super(); windows.push(this) }
+    isDestroyed() { return this.destroyed }
+    close() { this.destroyed = true; this.emit('closed') }
+    destroy() { this.close() }
+  }
+  return { handlers, windows, FakeWindow }
+})
+
+vi.mock('electron', () => ({
+  BrowserWindow: fixture.FakeWindow,
+  ipcMain: {
+    handle: (name: string, fn: (...args: unknown[]) => unknown) => fixture.handlers.set(name, fn),
+    removeHandler: (name: string) => fixture.handlers.delete(name),
+  },
+}))
+
+const { openScnetDiagnosticsWindow, scnetDiagnosticsWindowOptions } = await import('../src/scnet-diagnostics-window.ts')
+
+afterEach(() => {
+  for (const window of fixture.windows) if (!window.isDestroyed()) window.close()
+  fixture.windows.length = 0
+  fixture.handlers.clear()
+})
+
+it('creates a sandboxed local diagnostics window', () => {
+  const options = scnetDiagnosticsWindowOptions(resolveDesktopLocale('zh-CN'))
+  expect(options).toMatchObject({
+    width: 720, height: 620, useContentSize: true, center: true, show: false,
+    webPreferences: { nodeIntegration: false, contextIsolation: true, sandbox: true, webSecurity: true },
+  })
+  expect(options.webPreferences?.preload).toMatch(/preload-scnet-diagnostics\.cjs$/u)
+})
+
+it('accepts status reads only from its own top frame and cleans up on close', async () => {
+  const window = await openScnetDiagnosticsWindow(resolveDesktopLocale('en'), {
+    read: async () => ({
+      overall: 'needs-setup',
+      bundle: { state: 'ready', detail: '0.6.13' },
+      python: { state: 'ready', detail: '3.12.1 (python3)' },
+      credentials: { state: 'needs-setup', detail: 'not configured' },
+      backend: { state: 'needs-setup', detail: 'openapi' },
+      authentication: { state: 'needs-setup', detail: 'not configured' },
+    }),
+  })
+  const loadURL = Reflect.get(window, 'loadURL') as ReturnType<typeof vi.fn>
+  expect(loadURL).toHaveBeenCalledWith('dsh-app://shell/scnet-diagnostics.html')
+  const own = { sender: window.webContents, senderFrame: window.webContents.mainFrame }
+  const read = fixture.handlers.get(DESKTOP_IPC.scnetDiagnostics)!
+  expect(() => read({ ...own, senderFrame: {} })).toThrow('unowned')
+  await expect(read(own)).resolves.toMatchObject({ overall: 'needs-setup' })
+  const close = fixture.handlers.get(DESKTOP_IPC.scnetDiagnosticsClose)!
+  await close(own)
+  expect(fixture.handlers.size).toBe(0)
+})
