diff --git a/apps/desktop/renderer/scnet-diagnostics.css b/apps/desktop/renderer/scnet-diagnostics.css
new file mode 100644
index 0000000000..ab80344b5d
--- /dev/null
+++ b/apps/desktop/renderer/scnet-diagnostics.css
@@ -0,0 +1,44 @@
+@import url('./assets/window-material.css');
+
+:root {
+  color-scheme: light dark;
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  color: #17191c;
+  background: #f8f9fa;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    color: #f4f5f6;
+    background: #1b1c1f;
+  }
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 520px; min-height: 100vh; background: transparent; }
+main { min-height: 100vh; padding: 32px 36px 28px; background: var(--dsw-desktop-window-tint, transparent); }
+.topbar { display: flex; gap: 24px; align-items: flex-start; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); }
+.eyebrow { margin: 0 0 6px; color: #777d84; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
+h1 { margin: 0; font-size: 25px; line-height: 32px; font-weight: 650; }
+.summary { max-width: 460px; margin: 7px 0 0; color: #686f76; font-size: 14px; line-height: 20px; }
+.actions { display: flex; gap: 8px; align-items: center; }
+button { border: 1px solid color-mix(in srgb, currentColor 18%, transparent); border-radius: 7px; padding: 8px 13px; color: inherit; background: color-mix(in srgb, currentColor 4%, transparent); font: inherit; cursor: pointer; }
+button:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
+button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
+#refresh { width: 36px; height: 36px; padding: 0; font-size: 20px; line-height: 1; }
+.checks { display: grid; gap: 10px; padding: 24px 0 14px; }
+.check { display: grid; grid-template-columns: 13px minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 58px; padding: 12px 14px; border: 1px solid color-mix(in srgb, currentColor 12%, transparent); border-radius: 8px; background: color-mix(in srgb, currentColor 3%, transparent); }
+button.check { width: 100%; text-align: left; }
+button.check:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
+.dot { width: 9px; height: 9px; border-radius: 50%; background: #7c838b; }
+.check[data-state="ready"] .dot { background: #1f9d68; }
+.check[data-state="needs-setup"] .dot { background: #d28c24; }
+.check[data-state="disabled"] .dot { background: #8d9298; }
+.check[data-state="unavailable"] .dot { background: #c74b4b; }
+.check-name { font-size: 14px; font-weight: 600; }
+.check-detail { color: #737980; font-size: 13px; text-align: right; }
+.privacy { margin: 8px 0 0; color: #81868c; font-size: 12px; line-height: 18px; }
+@media (prefers-color-scheme: dark) {
+  .summary, .check-detail { color: #b1b6bc; }
+  .eyebrow, .privacy { color: #9298a0; }
+}
