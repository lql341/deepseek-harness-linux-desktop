@@ -0,0 +1,210 @@
+/** Shell-owned lower-left update entry point for the client and Harness core. */
+
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC, type DesktopUpdatePresentation } from './ipc.ts'
+import type { HarnessUpdatePresentation } from './ipc.ts'
+
+const copy = {
+  en: {
+    title: 'Updates',
+    current: 'Client {client} · Harness {harness}',
+    checking: 'Checking for updates…',
+    available: 'Harness {version} is available',
+    installing: 'Installing Harness {version}…',
+    clientAvailable: 'Client {version} is available',
+    installClient: 'Install client update',
+    client: 'Open client update',
+    harness: 'View Harness release',
+    installHarness: 'Install Harness update',
+    check: 'Check for updates',
+    currentNotice: 'Already up to date',
+    failed: 'Action failed; try again',
+    close: 'Dismiss',
+  },
+  'zh-CN': {
+    title: '更新',
+    current: '客户端 {client} · Harness {harness}',
+    checking: '正在检查更新…',
+    available: 'Harness {version} 可用',
+    installing: '正在安装 Harness {version}…',
+    clientAvailable: '客户端 {version} 可用',
+    installClient: '安装客户端更新',
+    client: '查看客户端更新',
+    harness: '查看 Harness 发布',
+    installHarness: '安装 Harness 更新',
+    check: '检查更新',
+    currentNotice: '已经是最新版本',
+    failed: '操作失败，请重试',
+    close: '关闭',
+  },
+} as const
+
+interface UpdateBridge {
+  clientStatus(): Promise<DesktopUpdatePresentation>
+  clientOpen(): Promise<void>
+  clientSubscribe(listener: (state: DesktopUpdatePresentation) => void): () => void
+  harnessStatus(): Promise<HarnessUpdatePresentation>
+  harnessOpen(): Promise<void>
+  harnessInstall(): Promise<HarnessUpdatePresentation>
+  harnessSubscribe(listener: (state: HarnessUpdatePresentation) => void): () => void
+}
+
+const bridge: UpdateBridge = {
+  clientStatus: () => ipcRenderer.invoke(DESKTOP_IPC.updatesStatus) as Promise<DesktopUpdatePresentation>,
+  clientOpen: () => ipcRenderer.invoke(DESKTOP_IPC.updatesOpen) as Promise<void>,
+  clientSubscribe(listener) {
+    const handle = (_event: Electron.IpcRendererEvent, state: DesktopUpdatePresentation): void => {
+      listener(state)
+    }
+    ipcRenderer.on(DESKTOP_IPC.updatesPresentation, handle)
+    return () => { ipcRenderer.off(DESKTOP_IPC.updatesPresentation, handle) }
+  },
+  harnessStatus: () => ipcRenderer.invoke(DESKTOP_IPC.harnessUpdatesStatus) as Promise<HarnessUpdatePresentation>,
+  harnessOpen: () => ipcRenderer.invoke(DESKTOP_IPC.harnessUpdatesOpen) as Promise<void>,
+  harnessInstall: () => ipcRenderer.invoke(DESKTOP_IPC.harnessUpdatesInstall) as Promise<HarnessUpdatePresentation>,
+  harnessSubscribe(listener) {
+    const handle = (_event: Electron.IpcRendererEvent, state: HarnessUpdatePresentation): void => {
+      listener(state)
+    }
+    ipcRenderer.on(DESKTOP_IPC.harnessUpdatesPresentation, handle)
+    return () => { ipcRenderer.off(DESKTOP_IPC.harnessUpdatesPresentation, handle) }
+  },
+}
+
+function install(): void {
+  if (document.querySelector('[data-dsh-update-status]') !== null) return
+  const host = document.createElement('div')
+  host.dataset.dshUpdateStatus = ''
+  const shadow = host.attachShadow({ mode: 'open' })
+  const style = document.createElement('style')
+  style.textContent = `
+    :host { all: initial; }
+    .surface { align-items: center; backdrop-filter: blur(14px); background: color-mix(in srgb, Canvas 90%, transparent);
+      border: 1px solid color-mix(in srgb, CanvasText 14%, transparent); border-radius: 10px; box-shadow: 0 5px 22px rgb(0 0 0 / 12%);
+      color: CanvasText; display: grid; font: 12px/16px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+      gap: 5px; max-width: min(390px, calc(100vw - 28px)); padding: 9px 10px 9px 11px; }
+    .top { align-items: center; display: flex; gap: 8px; }
+    .dot { background: #8d9298; border-radius: 50%; flex: 0 0 8px; height: 8px; width: 8px; }
+    .dot[data-state="available"] { background: #c74b4b; }
+    .dot[data-state="checking"] { background: #d28c24; }
+    .copy { display: grid; gap: 1px; min-width: 0; }
+    .title { font-weight: 650; }
+    .detail { color: color-mix(in srgb, CanvasText 68%, transparent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+    .actions { display: flex; gap: 9px; padding-left: 16px; }
+    button { background: transparent; border: 0; color: inherit; cursor: pointer; font: inherit; padding: 2px 0; text-align: left; }
+    button:hover { text-decoration: underline; }
+    button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 3px; }
+    .dismiss { color: color-mix(in srgb, CanvasText 52%, transparent); font-size: 16px; line-height: 16px; margin-left: auto; padding: 0 2px 2px 3px; }
+  `
+  const surface = document.createElement('div')
+  surface.className = 'surface'
+  const top = document.createElement('div')
+  top.className = 'top'
+  const dot = document.createElement('span')
+  dot.className = 'dot'
+  dot.setAttribute('aria-hidden', 'true')
+  const copyBox = document.createElement('span')
+  copyBox.className = 'copy'
+  const title = document.createElement('span')
+  title.className = 'title'
+  const detail = document.createElement('span')
+  detail.className = 'detail'
+  copyBox.append(title, detail)
+  const dismiss = document.createElement('button')
+  dismiss.className = 'dismiss'
+  dismiss.type = 'button'
+  dismiss.textContent = '×'
+  top.append(dot, copyBox, dismiss)
+  const actions = document.createElement('div')
+  actions.className = 'actions'
+  const client = document.createElement('button')
+  client.type = 'button'
+  const harness = document.createElement('button')
+  harness.type = 'button'
+  actions.append(client, harness)
+  surface.append(top, actions)
+  shadow.append(style, surface)
+  Object.assign(host.style, { bottom: '14px', left: '14px', position: 'fixed', zIndex: '2147483640' })
+  document.body.append(host)
+
+  let clientState: DesktopUpdatePresentation = { phase: 'idle' }
+  let harnessState: HarnessUpdatePresentation = { phase: 'idle', currentVersion: 'unknown' }
+  let notice: string | undefined
+  const language = (document.documentElement.lang || navigator.language).toLowerCase().startsWith('zh') ? 'zh-CN' : 'en'
+  const m = copy[language]
+  function render(): void {
+    const clientVersion = clientState.currentVersion ?? '—'
+    const harnessVersion = harnessState.currentVersion
+    const available = harnessState.phase === 'available'
+    const clientAvailable = clientState.phase === 'available' || clientState.phase === 'ready'
+    title.textContent = m.title
+    detail.textContent = notice
+      ?? (available && harnessState.availableVersion !== undefined
+        ? m.available.replace('{version}', harnessState.availableVersion)
+        : clientAvailable && clientState.version !== undefined
+          ? m.clientAvailable.replace('{version}', clientState.version)
+          : harnessState.phase === 'installing' && harnessState.availableVersion !== undefined
+            ? m.installing.replace('{version}', harnessState.availableVersion)
+            : harnessState.phase === 'checking' || clientState.phase === 'checking'
+              ? m.checking
+              : m.current.replace('{client}', clientVersion).replace('{harness}', harnessVersion))
+    dot.dataset.state = available || clientAvailable ? 'available' : harnessState.phase === 'checking' || clientState.phase === 'checking' ? 'checking' : 'current'
+    client.textContent = clientAvailable ? m.installClient : m.check
+    harness.textContent = available ? m.installHarness : m.harness
+    dismiss.setAttribute('aria-label', m.close)
+    client.disabled = clientState.phase === 'checking' || clientState.phase === 'downloading' || clientState.phase === 'installing' || harnessState.phase === 'installing'
+    harness.disabled = harnessState.phase === 'checking' || harnessState.phase === 'installing'
+  }
+  async function refresh(): Promise<void> {
+    try {
+      ;[clientState, harnessState] = await Promise.all([bridge.clientStatus(), bridge.harnessStatus()])
+      render()
+    } catch { dispose() }
+  }
+  function dispose(): void {
+    stopClient()
+    stopHarness()
+    window.removeEventListener('focus', onFocus)
+    window.removeEventListener('pagehide', onPageHide)
+    host.remove()
+  }
+  const stopClient = bridge.clientSubscribe((state) => {
+    clientState = state
+    render()
+  })
+  const stopHarness = bridge.harnessSubscribe((state) => {
+    harnessState = state
+    render()
+  })
+  function onFocus(): void { void refresh() }
+  function onPageHide(): void { dispose() }
+  dismiss.addEventListener('click', dispose)
+  const run = async (operation: () => Promise<void>): Promise<void> => {
+    notice = undefined
+    render()
+    try {
+      await operation()
+      await refresh()
+      if (harnessState.phase === 'current' && clientState.phase !== 'available') {
+        notice = m.currentNotice
+        render()
+      }
+    } catch {
+      notice = m.failed
+      render()
+    }
+  }
+  client.addEventListener('click', () => { void run(() => bridge.clientOpen()) })
+  harness.addEventListener('click', () => {
+    void run(() => harnessState.phase === 'available' ? bridge.harnessInstall().then(() => undefined) : bridge.harnessOpen())
+  })
+  window.addEventListener('focus', onFocus)
+  window.addEventListener('pagehide', onPageHide, { once: true })
+  render()
+  void refresh()
+}
+
+export function installUpdateStatusSurface(): void {
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true })
+  else install()
+}
