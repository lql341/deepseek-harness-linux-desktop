diff --git a/apps/desktop/renderer/scnet-diagnostics.js b/apps/desktop/renderer/scnet-diagnostics.js
new file mode 100644
index 0000000000..3c9035757e
--- /dev/null
+++ b/apps/desktop/renderer/scnet-diagnostics.js
@@ -0,0 +1,62 @@
+(() => {
+  const api = window.dshScnetDiagnostics
+  if (!api) return
+  const m = api.locale.messages
+  document.documentElement.lang = api.locale.id
+  document.title = m.scnetDiagnosticsTitle
+  document.getElementById('eyebrow').textContent = m.scnetDiagnosticsEyebrow
+  document.getElementById('title').textContent = m.scnetDiagnosticsTitle
+  document.getElementById('refresh').ariaLabel = m.scnetDiagnosticsRefresh
+  document.getElementById('refresh').title = m.scnetDiagnosticsRefresh
+  document.getElementById('close').textContent = m.scnetDiagnosticsClose
+  document.getElementById('checks').ariaLabel = m.scnetDiagnosticsChecks
+  document.getElementById('privacy').textContent = m.scnetDiagnosticsPrivacy
+
+  const rows = [
+    ['bundle', m.scnetDiagnosticsBundle],
+    ['python', m.scnetDiagnosticsPython],
+    ['credentials', m.scnetDiagnosticsCredentials],
+    ['backend', m.scnetDiagnosticsBackend],
+    ['authentication', m.scnetDiagnosticsAuthentication],
+  ]
+  const checks = document.getElementById('checks')
+  const stateLabel = state => ({
+    ready: m.scnetDiagnosticsReady,
+    'needs-setup': m.scnetDiagnosticsNeedsSetup,
+    unavailable: m.scnetDiagnosticsUnavailable,
+    disabled: m.scnetDiagnosticsDisabled,
+  })[state] || m.scnetDiagnosticsUnavailable
+  const detail = (key, value) => {
+    if (key === 'bundle') return m.scnetDiagnosticsBundleVersion.replace('{version}', value)
+    if (key === 'python' && value.startsWith('Python 3')) return value
+    if (key === 'credentials') return value === 'configured' ? m.scnetDiagnosticsCredentialConfigured : value === 'not configured' ? m.scnetDiagnosticsCredentialMissing : m.scnetDiagnosticsSecureStore.replace('{provider}', value)
+    if (key === 'backend') return value === 'openapi' ? m.scnetDiagnosticsBackendOpenapi : value === 'ssh' ? m.scnetDiagnosticsBackendSsh : value
+    if (key === 'authentication') return value === 'authorization required' ? m.scnetDiagnosticsAuthorizationRequired : m.scnetDiagnosticsCredentialMissing
+    return value
+  }
+  const render = async () => {
+    const status = await api.read()
+    document.getElementById('summary').textContent = ({
+      ready: m.scnetDiagnosticsOverallReady,
+      'needs-setup': m.scnetDiagnosticsOverallNeedsSetup,
+      unavailable: m.scnetDiagnosticsOverallUnavailable,
+      disabled: m.scnetDiagnosticsOverallDisabled,
+    })[status.overall]
+    checks.replaceChildren(...rows.map(([key, label]) => {
+      const value = status[key]
+      const actionable = key === 'credentials' || key === 'authentication'
+      const row = document.createElement(actionable ? 'button' : 'div')
+      row.className = 'check'
+      if (actionable) row.type = 'button'
+      row.dataset.state = value.state
+      row.innerHTML = '<span class="dot" aria-hidden="true"></span><span class="check-name"></span><span class="check-detail"></span>'
+      row.querySelector('.check-name').textContent = label
+      row.querySelector('.check-detail').textContent = value.state === 'ready' ? detail(key, value.detail) : stateLabel(value.state)
+      if (actionable) row.addEventListener('click', () => { void api.setup().catch(() => {}) })
+      return row
+    }))
+  }
+  document.getElementById('refresh').addEventListener('click', () => { void render() })
+  document.getElementById('close').addEventListener('click', () => { void api.close() })
+  void render()
+})()
