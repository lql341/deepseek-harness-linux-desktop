--- /dev/null
+++ b/apps/desktop/tests/harness-update.spec.ts
@@ -0,0 +1,139 @@
+import { createHash } from 'node:crypto'
+import { describe, expect, it, vi } from 'vitest'
+import { HarnessUpdateCoordinator, parseHarnessReleases, type HarnessUpdateDependencies } from '../src/harness-update.ts'
+
+describe('Harness update discovery', () => {
+  const releases = [
+    { tag_name: 'v0.2.1-alpha.1-linux.1', html_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-alpha.1-linux.1', draft: false },
+    { tag_name: 'v0.2.1-rc.3-linux.1', html_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.3-linux.1', draft: false },
+    { tag_name: 'v0.2.1-rc.2-linux.1', html_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.2-linux.1', draft: false },
+  ]
+
+  it('sorts releases and excludes alpha by default', () => {
+    expect(parseHarnessReleases(releases)).toEqual([
+      { version: '0.2.1-rc.3', tag: 'v0.2.1-rc.3-linux.1', url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.3-linux.1' },
+      { version: '0.2.1-rc.2', tag: 'v0.2.1-rc.2-linux.1', url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.2-linux.1' },
+    ])
+  })
+
+  it('reports a newer core without accepting a renderer-supplied URL', async () => {
+    const coordinator = new HarnessUpdateCoordinator({
+      currentVersion: '0.2.1-rc.2',
+      currentReleaseTag: 'v0.2.1-rc.2-linux.1',
+      packaged: true,
+      fetch: async () => new Response(JSON.stringify(releases), { status: 200 }),
+      environment: {},
+    })
+    await expect(coordinator.check()).resolves.toMatchObject({
+      phase: 'available',
+      availableVersion: '0.2.1-rc.3',
+      releaseUrl: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.3-linux.1',
+    })
+  })
+
+  it('detects a newer Linux build with the same app version', async () => {
+    const coordinator = new HarnessUpdateCoordinator({
+      currentVersion: '0.2.1-rc.2',
+      currentReleaseTag: 'v0.2.1-rc.2-linux.1',
+      packaged: true,
+      fetch: async () => new Response(JSON.stringify([
+        { tag_name: 'v0.2.1-rc.2-linux.2', html_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.2-linux.2', draft: false },
+      ]), { status: 200 }),
+      environment: {},
+    })
+    await expect(coordinator.check()).resolves.toMatchObject({ phase: 'available', releaseTag: 'v0.2.1-rc.2-linux.2' })
+  })
+
+  it('allows alpha only when explicitly enabled', () => {
+    expect(parseHarnessReleases(releases, { DSH_HARNESS_UPDATE_ALLOW_ALPHA: '1' }).find(item => item.version.includes('-alpha'))).toMatchObject({
+      version: '0.2.1-alpha.1',
+    })
+  })
+})
+
+describe('release trust and support floor', () => {
+  const signed = [
+    { tag_name: 'v0.2.1-rc.5-linux.2', html_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/tag/v0.2.1-rc.5-linux.2', draft: false,
+      assets: [
+        { name: 'deepseek-harness-0.2.1-rc.5-linux-amd64.deb', browser_download_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/download/v0.2.1-rc.5-linux.2/pkg.deb' },
+        { name: 'SHA256SUMS', browser_download_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/download/v0.2.1-rc.5-linux.2/SHA256SUMS' },
+        { name: 'SHA256SUMS.sig', browser_download_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/download/v0.2.1-rc.5-linux.2/SHA256SUMS.sig' },
+        { name: 'desktop-policy.json', browser_download_url: 'https://github.com/lql341/deepseek-harness-linux-desktop/releases/download/v0.2.1-rc.5-linux.2/desktop-policy.json' },
+      ] },
+  ]
+  const debBytes = new TextEncoder().encode('package bytes')
+  const manifest = new TextEncoder().encode(
+    `${createHash('sha256').update(debBytes).digest('hex')}  deepseek-harness-0.2.1-rc.5-linux-amd64.deb\n`)
+
+  function fetcher(policy: unknown): typeof fetch {
+    return (async (input: string | URL) => {
+      const url = String(input)
+      if (url.includes('/releases') && !url.includes('/releases/download')) return Response.json(signed)
+      if (url.endsWith('/SHA256SUMS')) return new Response(manifest)
+      if (url.endsWith('/SHA256SUMS.sig')) return new Response('signature')
+      if (url.endsWith('/desktop-policy.json')) return Response.json(policy)
+      if (url.endsWith('/pkg.deb')) return new Response(debBytes)
+      return new Response('missing', { status: 404 })
+    }) as typeof fetch
+  }
+
+  function coordinator(overrides: Partial<HarnessUpdateDependencies> = {}) {
+    return new HarnessUpdateCoordinator({
+      currentVersion: '0.2.1-rc.4', currentReleaseTag: 'v0.2.1-rc.4-linux.1', packaged: true,
+      environment: {}, platform: 'linux', fetch: fetcher({ minimumSupportedVersion: '0.2.1-rc.5' }), ...overrides,
+    })
+  }
+
+  it('refuses to install a release without a manifest signature', async () => {
+    const installPackage = vi.fn(async () => {})
+    const unsignedRelease = [{ ...signed[0]!, assets: signed[0]!.assets.filter(asset => asset.name !== 'SHA256SUMS.sig') }]
+    const instance = new HarnessUpdateCoordinator({
+      currentVersion: '0.2.1-rc.4', currentReleaseTag: 'v0.2.1-rc.4-linux.1', packaged: true,
+      environment: {}, platform: 'linux', installPackage,
+      fetch: (async (input: string | URL) => {
+        const url = String(input)
+        if (url.includes('/releases') && !url.includes('/releases/download')) return Response.json(unsignedRelease)
+        if (url.endsWith('/desktop-policy.json')) return Response.json({ minimumSupportedVersion: '0.2.1-rc.5' })
+        if (url.endsWith('/SHA256SUMS')) return new Response(manifest)
+        if (url.endsWith('/pkg.deb')) return new Response(debBytes)
+        return new Response('missing', { status: 404 })
+      }) as typeof fetch,
+    })
+    await expect(instance.install()).resolves.toMatchObject({ phase: 'error', error: 'untrusted' })
+    expect(installPackage).not.toHaveBeenCalled()
+  })
+
+  it('stops before the privileged step when the signature does not verify', async () => {
+    const installPackage = vi.fn(async () => {})
+    const instance = coordinator({ verifyManifest: () => false, installPackage })
+    await expect(instance.install()).resolves.toMatchObject({ phase: 'error', error: 'untrusted' })
+    expect(installPackage).not.toHaveBeenCalled()
+  })
+
+  it('installs only after the signature and the checksum both pass', async () => {
+    const installPackage = vi.fn(async () => {})
+    const instance = coordinator({ verifyManifest: () => true, installPackage })
+    await expect(instance.install()).resolves.toMatchObject({ phase: 'installed' })
+    expect(installPackage).toHaveBeenCalledOnce()
+  })
+
+  it('reports a required update when the release raises the support floor', async () => {
+    const instance = coordinator({ fetch: fetcher({ minimumSupportedVersion: '0.2.1-rc.5' }) })
+    await expect(instance.check()).resolves.toMatchObject({
+      phase: 'required', availableVersion: '0.2.1-rc.5', requiredVersion: '0.2.1-rc.5',
+    })
+  })
+
+  it('keeps a newer release optional when the support floor is already met', async () => {
+    const instance = new HarnessUpdateCoordinator({
+      currentVersion: '0.2.1-rc.5', currentReleaseTag: 'v0.2.1-rc.5-linux.1', packaged: true, environment: {}, platform: 'linux',
+      fetch: fetcher({ minimumSupportedVersion: '0.2.1-rc.5', minimumSupportedBuild: 1 }),
+    })
+    await expect(instance.check()).resolves.toMatchObject({ phase: 'available' })
+  })
+
+  it('reports an unparsable policy instead of silently ignoring the floor', async () => {
+    const instance = coordinator({ fetch: fetcher({ minimumSupportedVersion: 'not-a-version' }) })
+    await expect(instance.check()).resolves.toMatchObject({ phase: 'error', error: 'invalid' })
+  })
+})
