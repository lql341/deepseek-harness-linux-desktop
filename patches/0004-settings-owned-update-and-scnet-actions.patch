@@ -0,0 +1,55 @@
+/** Settings-owned client and Harness update action. */
+import { useState } from 'react'
+import { Button } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { DesktopUpdateView } from '../types.ts'
+import css from './DesktopUpdateSettingsRow.module.css'
+
+export interface DesktopUpdateSettingsRowInjected {
+  hooks: { desktopUpdate: ObservableSnapshot<DesktopUpdateView> }
+  enabled: boolean
+  onOpen(): void
+}
+
+type Props = PropsRuntime<'settings.general.item'> & PropsLocale<'settings'> & InjectFace<DesktopUpdateSettingsRowInjected>
+
+export function DesktopUpdateSettingsRow({ useDesktopUpdate, enabled, onOpen, t }: Props) {
+  const view = useDesktopUpdate(value => value)
+  const [busy, setBusy] = useState(false)
+  if (!enabled) return null
+  const presentation = view.presentation
+  const phase = presentation?.phase
+  const available = phase === 'available' || phase === 'ready'
+  const installing = phase === 'checking' || phase === 'downloading' || phase === 'verifying' || phase === 'installing' || busy
+  const description = view.failed || phase === 'error'
+    ? t('desktop.update.error')
+    : installing
+      ? t('desktop.update.checking')
+      : available && presentation?.version !== undefined
+        ? t('desktop.update.availableDetail', { version: presentation.version })
+        : phase === 'idle'
+          ? t('desktop.update.description')
+          : t('desktop.update.current')
+  const label = installing
+    ? t('desktop.update.installingAction')
+    : available
+      ? t('desktop.update.installAction')
+      : t('desktop.update.check')
+  return <div className={css.row}>
+    <div className={css.copy}>
+      <div className={css.title}>{t('desktop.update.title')}</div>
+      <div className={css.description}>{description}</div>
+      {(view.failed || phase === 'error') && <div className={css.error} role="alert">{t('desktop.update.error')}</div>}
+    </div>
+    <Button variant="outline" size="sm" disabled={installing || view.opening}
+      onClick={() => {
+        if (installing || view.opening) return
+        setBusy(true)
+        onOpen()
+        window.setTimeout(() => { setBusy(false) }, 500)
+      }}>
+      {label}
+    </Button>
+  </div>
+}
