+/**
+ * Resolve the updater configuration a packaging run writes for its target.
+ * macOS and Windows keep their COS deployments. Linux has no first-party feed, so it publishes
+ * AppImage metadata only when DESKTOP_LINUX_UPDATE_ORIGIN names the generic provider origin.
+ * @param {NodeJS.ProcessEnv} env - Packaging environment.
+ * @param {NodeJS.Platform} platform - Target Node.js platform.
+ * @param {string} arch - Target Node.js architecture.
+ * @returns {{ environment: 'test' | 'production' | 'linux', target: 'mac-arm64' | 'mac-x64' | 'win-x64' | 'linux-x64', origin: string, publicUrl: string, keyPrefix: string, binaryKeyPrefix: string } | undefined} Resolved updater configuration, or undefined when the target publishes no update metadata.
+ * @throws {Error} When the Linux origin is not a bare HTTPS origin, or a macOS or Windows deployment is invalid.
+ */
+export function resolveDesktopPackagingUpdateConfig(env, platform, arch) {
+  if (platform !== 'linux') return resolveDesktopAutoUpdateConfig(env, platform, arch)
+  const origin = env[DESKTOP_LINUX_UPDATE_ORIGIN]?.trim()
+  if (origin === undefined || origin === '') return undefined
+  const target = resolveDesktopAutoUpdateTarget(platform, arch)
+  const keyPrefix = `dsh-desk/feeds/${target}`
+  return {
+    environment: 'linux',
+    target,
+    origin: httpsOrigin(origin, DESKTOP_LINUX_UPDATE_ORIGIN),
+    keyPrefix,
+    binaryKeyPrefix: `dsh-desk/bin/${target}`,
+    publicUrl: `${httpsOrigin(origin, DESKTOP_LINUX_UPDATE_ORIGIN)}/${keyPrefix}/`,
+  }
+}
