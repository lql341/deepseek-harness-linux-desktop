+# Copy to .env.linux before packaging a Linux Desktop target. Use UTF-8 and quote values containing # or spaces.
+# Release settings are read from this file alone: ambient DSH_DESKTOP_*/APPLE_*/CSC_*/DOWNLOAD_* variables are ignored.
+# Linux needs no signing identity, notarization strategy, certificate, or COS credential.
+DSH_DESKTOP_APP_ID=com.deepseek.harness
+
+# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
+# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
+# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
+
+# AppImage self-updates are off unless this names the bare HTTPS origin of a generic provider that serves
+# the channel metadata (nightly-linux.yml) beside the AppImage. deb packages never self-update.
+# DSH_DESKTOP_LINUX_UPDATE_ORIGIN=https://downloads.example.com
+
+# Optional mandatory-update policy. Omit both origins to package Linux without a policy; when one is set,
+# DSH_DESKTOP_AUTO_UPDATE_ENV selects the deployment and the macOS and Windows rules apply unchanged.
+# DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
+# DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
+# DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
